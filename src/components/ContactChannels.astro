---
import Trans from './Trans.astro';

interface Props {
  variant?: 'wholesale' | 'general';
}

const { variant = 'general' } = Astro.props;

// Placeholder values — replace when real handles / numbers are set up.
const whatsapp = 'https://wa.me/905423494229'; // TODO: replace with real WA Business number
const emailGeneral = 'info@canicopet.com';
const emailWholesale = 'info@canicopet.com';
const email = variant === 'wholesale' ? emailWholesale : emailGeneral;
const instagram = 'https://instagram.com/canicopet'; // TODO: confirm final handle
const linkedin = 'https://linkedin.com/company/canicopet'; // TODO: confirm final handle
---
<div class="channels">
  <a class="channel" href={whatsapp} target="_blank" rel="noopener">
    <div class="channel__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
        <path d="M20.5 3.5A11 11 0 0 0 2.7 17.1L1 23l6-1.6a11 11 0 0 0 5.3 1.3h.1a11 11 0 0 0 8.1-19.2ZM12.3 20.6h-.1a9 9 0 0 1-4.7-1.3l-.3-.2-3.6.9 1-3.5-.2-.4a9.1 9.1 0 1 1 7.9 4.5Zm5-6.7c-.3-.1-1.6-.8-1.9-.9s-.4-.1-.6.2c-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.8-.7-1.4-1.7-1.6-2s0-.3.1-.4l.4-.4c.1-.1.2-.3.3-.5s.1-.3 0-.5c-.1-.1-.6-1.5-.8-2s-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.3s-1 1-1 2.4c0 1.4 1 2.7 1.2 2.9.1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.6-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3Z"/>
      </svg>
    </div>
    <div class="channel__body">
      <p class="channel__label">WhatsApp</p>
      <p class="channel__value">
        <Trans en="Best for TR wholesale" tr="TR toptan için uygun" />
      </p>
    </div>
  </a>

  <a class="channel" href={`mailto:${email}`}>
    <div class="channel__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="3" y="5" width="18" height="14" rx="2"/>
        <path d="m3 7 9 6 9-6"/>
      </svg>
    </div>
    <div class="channel__body">
      <p class="channel__label">
        <Trans en="Email" tr="E-posta" />
      </p>
      <p class="channel__value">{email}</p>
    </div>
  </a>

  <a class="channel" href={instagram} target="_blank" rel="noopener">
    <div class="channel__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="3" y="3" width="18" height="18" rx="5"/>
        <circle cx="12" cy="12" r="4"/>
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
      </svg>
    </div>
    <div class="channel__body">
      <p class="channel__label">Instagram</p>
      <p class="channel__value">@canicopet</p>
    </div>
  </a>

  <a class="channel" href={linkedin} target="_blank" rel="noopener">
    <div class="channel__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
        <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1c.5-1 1.9-2 3.9-2 4.2 0 5 2.7 5 6.2V21h-4v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-4V9Z"/>
      </svg>
    </div>
    <div class="channel__body">
      <p class="channel__label">LinkedIn</p>
      <p class="channel__value">
        <Trans en="For EU wholesalers" tr="AB toptancıları için" />
      </p>
    </div>
  </a>

  <a class="channel channel--form" href="#contact-form">
    <div class="channel__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M4 4h16v16H4z"/>
        <path d="M8 9h8M8 13h8M8 17h5"/>
      </svg>
    </div>
    <div class="channel__body">
      <p class="channel__label">
        <Trans en="Form" tr="Form" />
      </p>
      <p class="channel__value">
        <Trans en="Use the form below" tr="Aşağıdaki formu kullanın" />
      </p>
    </div>
  </a>
</div>

<section id="contact-form" class="contact-form">
  <h3>
    <Trans en="Send us a message" tr="Bize mesaj gönderin" />
  </h3>
  <p class="contact-form__note">
    <span class="placeholder-note">
      <Trans en="Placeholder" tr="Yer tutucu" />
    </span>
    <Trans
      en="Form endpoint is not connected yet. Submissions will not be delivered until a form provider (Formspree, Basin, or similar) is configured."
      tr="Form uç noktası henüz bağlı değil. Bir form sağlayıcısı (Formspree, Basin veya benzeri) yapılandırılana kadar gönderiler iletilmez."
    />
  </p>
  <form class="cform" method="post" action="#">
    <label class="cform__row">
      <span><Trans en="Your name" tr="Adınız" /></span>
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label class="cform__row">
      <span><Trans en="Company (optional)" tr="Şirket (opsiyonel)" /></span>
      <input type="text" name="company" autocomplete="organization" />
    </label>
    <label class="cform__row">
      <span><Trans en="Email" tr="E-posta" /></span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <label class="cform__row">
      <span><Trans en="What can we help with?" tr="Nasıl yardımcı olabiliriz?" /></span>
      <select name="topic">
        <option value="wholesale"><Trans en="Wholesale inquiry" tr="Toptan talebi" /></option>
        <option value="private-label"><Trans en="Private label" tr="Özel marka" /></option>
        <option value="sample"><Trans en="Sample request" tr="Numune talebi" /></option>
        <option value="other"><Trans en="Other" tr="Diğer" /></option>
      </select>
    </label>
    <label class="cform__row">
      <span><Trans en="Message" tr="Mesaj" /></span>
      <textarea name="message" rows="5" required></textarea>
    </label>
    <button type="submit" class="btn btn--primary">
      <Trans en="Send" tr="Gönder" />
    </button>
  </form>
</section>

<style>
  .channels {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-block: var(--space-5);
    max-width: 640px;
  }
  @media (min-width: 640px) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    background: white;
    transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    min-width: 0;
  }
  .channel:hover {
    border-color: var(--color-coral);
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
    color: inherit;
  }
  .channel__icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--color-coral) 12%, transparent);
    border-radius: 12px;
    color: var(--color-coral);
  }
  .channel__body { min-width: 0; }
  .channel__label {
    margin: 0;
    font-weight: 700;
    font-size: 14px;
    color: var(--color-ink);
  }
  .channel__value {
    margin: 2px 0 0 0;
    color: var(--color-muted);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .contact-form {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--color-bg-soft);
    border-radius: var(--radius-lg);
    border: 1.5px solid var(--color-line);
    max-width: 640px;
  }
  .contact-form__note {
    color: var(--color-muted);
    font-size: 13px;
    margin-bottom: var(--space-4);
  }
  .cform {
    display: grid;
    gap: var(--space-3);
  }
  .cform__row {
    display: grid;
    gap: 4px;
  }
  .cform__row > span {
    font-size: 13px;
    color: var(--color-ink-soft);
    font-weight: 500;
  }
  .cform input,
  .cform select,
  .cform textarea {
    font-family: var(--font-sans);
    font-size: 15px;
    padding: 10px 12px;
    border-radius: var(--radius);
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-ink);
    width: 100%;
  }
  .cform textarea { resize: vertical; }
  .cform button {
    justify-self: start;
    margin-top: var(--space-2);
  }
</style>
