---
import Trans from './Trans.astro';
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path.startsWith(p + '/');
---
<header class="site-nav">
  <div class="container site-nav__inner">
    <a href="/" class="site-nav__brand" aria-label="Canico Pets home">
      <img src="/logo-placeholder.svg" alt="Canico Pets" width="200" height="50" />
    </a>

    <button
      class="site-nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-drawer"
      aria-label="Toggle menu"
    >
      <span class="site-nav__toggle-bar" aria-hidden="true"></span>
      <span class="site-nav__toggle-bar" aria-hidden="true"></span>
      <span class="site-nav__toggle-bar" aria-hidden="true"></span>
    </button>

    <div id="site-nav-drawer" class="site-nav__drawer" data-open="false">
      <nav class="site-nav__nav" aria-label="Primary">
        <ul class="site-nav__links">
          <li><a href="/products" class:list={[{ 'is-active': isActive('/products') }]}>
            <Trans en="Products" tr="Ürünler" />
          </a></li>
          <li><a href="/wholesale" class:list={[{ 'is-active': isActive('/wholesale') }]}>
            <Trans en="Wholesale" tr="Toptan" />
          </a></li>
          <li><a href="/private-label" class:list={[{ 'is-active': isActive('/private-label') }]}>
            <Trans en="Private Label" tr="Özel Marka" />
          </a></li>
          <li><a href="/about" class:list={[{ 'is-active': isActive('/about') }]}>
            <Trans en="About" tr="Hakkımızda" />
          </a></li>
          <li><a href="/contact" class:list={[{ 'is-active': isActive('/contact') }]}>
            <Trans en="Contact" tr="İletişim" />
          </a></li>
        </ul>
      </nav>
      <div class="lang-toggle" role="group" aria-label="Language">
        <button type="button" data-lang-switch="en" aria-pressed="true" aria-label="Switch to English">EN</button>
        <button type="button" data-lang-switch="tr" aria-pressed="false" aria-label="Türkçe'ye geç">TR</button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('.site-nav__toggle');
    var drawer = document.getElementById('site-nav-drawer');
    if (!btn || !drawer) return;

    function setOpen(open) {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      drawer.dataset.open = open ? 'true' : 'false';
      document.body.style.overflow = open ? 'hidden' : '';
    }

    btn.addEventListener('click', function () {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>

<style>
  .site-nav {
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-line);
  }
  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: 12px;
    min-height: 70px;
    flex-wrap: nowrap;
  }
  .site-nav__brand {
    flex-shrink: 0;
    line-height: 0;
  }
  .site-nav__brand img {
    height: 40px;
    width: auto;
    transition: transform 200ms ease;
    display: block;
  }
  .site-nav__brand:hover img { transform: rotate(-2deg); }

  /* Hamburger button */
  .site-nav__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: 1.5px solid var(--color-line);
    border-radius: 12px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .site-nav__toggle-bar {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Drawer (contains nav + lang toggle) */
  .site-nav__drawer {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* Mobile: drawer collapses into a full-width panel below the bar */
  @media (max-width: 899px) {
    .site-nav__drawer {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-line);
      padding: var(--space-3) var(--space-4) var(--space-4);
      gap: var(--space-3);
      transform-origin: top;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 260ms ease, opacity 200ms ease, padding 200ms ease;
      pointer-events: none;
    }
    .site-nav__drawer[data-open="true"] {
      max-height: 500px;
      opacity: 1;
      padding-block: var(--space-3) var(--space-4);
      pointer-events: auto;
      box-shadow: 0 10px 30px rgba(27,27,36,0.06);
    }
    .site-nav__nav { width: 100%; }
    .site-nav__links {
      flex-direction: column;
      gap: 2px;
      align-items: stretch;
    }
    .site-nav__links a {
      display: block;
      padding: 12px 14px;
      font-size: 17px;
      border-radius: 12px;
    }
    .site-nav__links a.is-active {
      background: color-mix(in srgb, var(--color-sunshine) 30%, transparent);
      color: var(--color-ink);
    }
    .site-nav__links a.is-active::after { display: none; }
    .lang-toggle { align-self: flex-start; }
  }

  /* Desktop: hide hamburger, drawer sits inline */
  @media (min-width: 900px) {
    .site-nav__toggle { display: none; }
    .site-nav__drawer {
      position: static;
      max-height: none;
      opacity: 1;
      pointer-events: auto;
      background: transparent;
      padding: 0;
      border: 0;
    }
  }

  .site-nav__nav { display: block; }
  .site-nav__links {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: nowrap;
  }

  .site-nav__links a {
    position: relative;
    text-decoration: none;
    color: var(--color-ink-soft);
    font-weight: 600;
    font-size: 15px;
    padding: 8px 4px;
    transition: color 140ms ease;
    white-space: nowrap;
    display: inline-block;
  }
  /* Reserve the underline space so hover/active states never shift layout. */
  .site-nav__links a::after {
    content: '';
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 2px;
    height: 2px;
    background: var(--color-coral);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 160ms ease;
    border-radius: 2px;
  }
  .site-nav__links a:hover { color: var(--color-coral); }
  .site-nav__links a:hover::after { transform: scaleX(1); }
  .site-nav__links a.is-active { color: var(--color-ink); }
  .site-nav__links a.is-active::after {
    transform: scaleX(1);
    background: var(--color-ink);
  }
</style>
