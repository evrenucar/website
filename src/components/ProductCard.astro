---
import Trans from './Trans.astro';
import { base } from '../lib/paths';

interface Props {
  href: string;
  name: string;
  nameTr?: string;
  tagline?: string;
  taglineTr?: string;
  image?: string;
  price?: string;
  status?: 'available' | 'coming-soon';
}

const {
  href,
  name,
  nameTr,
  tagline,
  taglineTr,
  image = `${base}/product-placeholder.svg`,
  price,
  status = 'coming-soon',
} = Astro.props;
---
<a class="product-card" href={href}>
  <div class="product-card__media">
    <img src={image} alt={`${name} product image`} loading="lazy" />
    {status === 'coming-soon' && (
      <span class="product-card__badge">
        <Trans en="Coming soon" tr="Yakında" />
      </span>
    )}
    {status === 'available' && (
      <span class="product-card__badge product-card__badge--available">
        <Trans en="Available now" tr="Şimdi satışta" />
      </span>
    )}
  </div>
  <div class="product-card__body">
    <h3 class="product-card__name">
      <span lang="en">{name}</span>{nameTr && <span lang="tr">{nameTr}</span>}
    </h3>
    {tagline && (
      <p class="product-card__tagline">
        <span lang="en">{tagline}</span>{taglineTr && <span lang="tr">{taglineTr}</span>}
      </p>
    )}
    {price && <p class="product-card__price">{price}</p>}
  </div>
</a>

<style>
  .product-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: white;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  }
  .product-card:hover {
    border-color: var(--color-coral);
    transform: translateY(-4px) rotate(-0.4deg);
    box-shadow: var(--shadow-hover);
    color: inherit;
  }
  .product-card__media {
    position: relative;
    background: var(--color-bg-soft);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .product-card:hover .product-card__media img {
    transform: scale(1.04);
  }
  .product-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-family: var(--font-accent);
    font-size: 11px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  .product-card__badge--available {
    background: var(--color-coral);
  }
  .product-card__body {
    padding: var(--space-4);
  }
  .product-card__name {
    margin: 0 0 4px 0;
    font-size: 1.15rem;
  }
  .product-card__tagline {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
  }
  .product-card__price {
    margin: var(--space-3) 0 0 0;
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
