---
import BaseLayout from '../layouts/BaseLayout.astro';
import Trans from '../components/Trans.astro';
---
<BaseLayout title="Privacy" titleTr="Gizlilik" description="Privacy notice for canicopets.com." descriptionTr="canicopets.com gizlilik bildirimi.">
  <section class="section">
    <div class="container container--narrow">
      <p class="eyebrow"><Trans en="Privacy" tr="Gizlilik" /></p>
      <h1><Trans en="Privacy notice" tr="Gizlilik bildirimi" /></h1>
      <p class="placeholder-note">
        <Trans en="Placeholder. Replace with legally reviewed copy before launch." tr="Yer tutucu. Yayın öncesi hukuki incelemeden geçmiş metinle değiştirilecek." />
      </p>

      <h2><Trans en="What we collect" tr="Neleri topluyoruz" /></h2>
      <p>
        <Trans
          en="canicopets.com is a static marketing site. It does not collect personal data through forms or accounts. If you email us, we use your email address only to reply."
          tr="canicopets.com statik bir tanıtım sitesidir. Form veya hesap yoluyla kişisel veri toplamıyoruz. Bize e-posta yazarsanız, e-posta adresinizi yalnızca yanıt için kullanırız."
        />
      </p>

      <h2><Trans en="Analytics" tr="Analitik" /></h2>
      <p>
        <Trans
          en="If we add analytics later (for example Plausible or Fathom), this page will list what is collected and how to opt out."
          tr="İleride analitik eklersek (örneğin Plausible veya Fathom), bu sayfa neyin toplandığını ve nasıl vazgeçileceğini listeleyecek."
        />
      </p>

      <h2><Trans en="Cookies" tr="Çerezler" /></h2>
      <p><Trans en="This site does not set cookies." tr="Bu site çerez kullanmıyor." /></p>

      <h2><Trans en="Contact" tr="İletişim" /></h2>
      <p>
        <Trans en="Questions? Email" tr="Soru mu var? E-posta:" /> <a href="mailto:privacy@canicopets.com">privacy@canicopets.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
