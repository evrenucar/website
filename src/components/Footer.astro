---
import Trans from './Trans.astro';
import { base } from '../lib/paths';
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <div class="container">

    <div class="site-foot__nl">
      <div class="site-foot__nl-copy">
        <h3><Trans en="Get the letter." tr="Bültenimize abone olun." /></h3>
        <p>
          <Trans
            en="New products, restocks, and factory-floor updates. Roughly once a month. Unsubscribe any time."
            tr="Yeni ürünler, tekrar stoklar ve fabrikadan güncellemeler. Yaklaşık ayda bir. İstediğiniz zaman çıkabilirsiniz."
          />
        </p>
      </div>
      <form class="nlform" method="post" action="#">
        <label for="nl-email" class="visually-hidden">
          <Trans en="Email address" tr="E-posta adresi" />
        </label>
        <input id="nl-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
        <button type="submit"><Trans en="Sign up" tr="Kaydol" /></button>
      </form>
    </div>

    <div class="site-foot__grid">
      <div class="site-foot__brand">
        <img src={`${base}/caniko_logo_light1080.png`} alt="Canico Pets" width="200" height="50" decoding="sync" />
        <p class="site-foot__tag">
          <Trans en="Designed for pets. Made for modern homes." tr="Evcil hayvanlar için tasarlandı. Modern evler için üretildi." />
        </p>
        <div class="site-foot__social" aria-label="Social">
          <a href="https://instagram.com/canicopet" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://tiktok.com/@canicopet" aria-label="TikTok" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.5 8.2a6.6 6.6 0 0 1-3.9-1.3v7.8a5.7 5.7 0 1 1-5.7-5.7c.3 0 .6 0 .9.1v3a2.7 2.7 0 1 0 1.8 2.6V3h2.9a3.7 3.7 0 0 0 3.9 3.4V8.2Z"/></svg>
          </a>
          <a href="https://linkedin.com/company/canicopet" aria-label="LinkedIn" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1c.5-1 1.9-2 3.9-2 4.2 0 5 2.7 5 6.2V21h-4v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-4V9Z"/></svg>
          </a>
          <a href="mailto:info@canicopet.com" aria-label="Email">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </a>
        </div>
      </div>

      <div class="site-foot__col">
        <h4><Trans en="Shop" tr="Alışveriş" /></h4>
        <ul>
          <li><a href={`${base}/products`}><Trans en="All products" tr="Tüm ürünler" /></a></li>
          <li><a href={`${base}/products/litter-mat`}><Trans en="Cat Litter Collecting Mat" tr="Kedi Kumu Toplama Paspası" /></a></li>
          <li><a href={`${base}/products/scratching-pad`}><Trans en="Couch-Arm Scratching Pad" tr="Koltuk Kolu Tırmalama Pedi" /></a></li>
          <li><a href={`${base}/products`}><Trans en="For dogs (coming soon)" tr="Köpekler için (yakında)" /></a></li>
        </ul>
      </div>

      <div class="site-foot__col">
        <h4><Trans en="Business" tr="İş" /></h4>
        <ul>
          <li><a href={`${base}/wholesale`}><Trans en="Wholesale" tr="Toptan" /></a></li>
          <li><a href={`${base}/private-label`}><Trans en="Private label" tr="Özel marka" /></a></li>
          <li><a href={`${base}/contact`}><Trans en="Request samples" tr="Numune talep et" /></a></li>
        </ul>
      </div>

      <div class="site-foot__col">
        <h4><Trans en="Company" tr="Şirket" /></h4>
        <ul>
          <li><a href={`${base}/about`}><Trans en="About" tr="Hakkımızda" /></a></li>
          <li><a href={`${base}/contact`}><Trans en="Contact" tr="İletişim" /></a></li>
          <li><a href={`${base}/privacy`}><Trans en="Privacy" tr="Gizlilik" /></a></li>
          <li><a href={`${base}/imprint`}><Trans en="Imprint" tr="Künye" /></a></li>
        </ul>
      </div>
    </div>

    <div class="site-foot__bar">
      <p class="site-foot__legal">
        © {year} Canico Pet · Aktunc Tekstil, Ankara. <Trans en="All rights reserved." tr="Tüm hakları saklıdır." />
      </p>
      <div class="site-foot__region">
        <select aria-label="Region" disabled>
          <option>Türkiye (TRY)</option>
          <option>European Union (EUR)</option>
          <option>United Kingdom (GBP)</option>
          <option>United States (USD)</option>
        </select>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    background: var(--color-ink);
    color: var(--color-bg);
    padding-block: var(--space-7) var(--space-4);
  }
  .site-foot a {
    color: var(--color-bg);
    text-decoration: none;
    opacity: 0.78;
    transition: opacity 140ms ease, color 140ms ease;
  }
  .site-foot a:hover { opacity: 1; color: var(--color-coral); }

  /* Newsletter row across the top of the footer */
  .site-foot__nl {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid rgba(255,255,255,0.12);
    align-items: center;
  }
  @media (min-width: 720px) {
    .site-foot__nl { grid-template-columns: 1.1fr 1fr; gap: var(--space-6); }
  }
  .site-foot__nl h3 {
    color: var(--color-bg);
    margin: 0 0 6px 0;
    font-size: 1.5rem;
  }
  .site-foot__nl p {
    margin: 0;
    opacity: 0.7;
    font-size: 14px;
    max-width: 42ch;
  }
  .nlform {
    display: flex;
    gap: 6px;
    background: rgba(255,255,255,0.06);
    padding: 4px;
    border-radius: 999px;
    border: 1.5px solid rgba(255,255,255,0.15);
    min-width: 0;
  }
  .nlform input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 14px;
    outline: none;
  }
  .nlform input::placeholder { color: rgba(255,255,255,0.4); }
  .nlform button {
    background: var(--color-coral);
    color: white;
    border: 0;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 13px;
    padding: 8px 18px;
    cursor: pointer;
    transition: background 140ms ease, transform 140ms ease;
    white-space: nowrap;
  }
  .nlform button:hover {
    background: var(--color-sunshine);
    color: var(--color-ink);
    transform: translateY(-1px);
  }

  /* Main 4-column link grid */
  .site-foot__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .site-foot__grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; }
  }

  .site-foot__brand img {
    height: 46px;
    width: auto;
    margin-bottom: 12px;
  }
  .site-foot__tag {
    margin: 0 0 18px;
    font-size: 14px;
    opacity: 0.7;
    max-width: 32ch;
    line-height: 1.5;
  }
  .site-foot__social { display: flex; gap: 10px; }
  .site-foot__social a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1.5px solid rgba(255,255,255,0.18);
    border-radius: 999px;
    color: var(--color-bg);
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
    opacity: 1;
  }
  .site-foot__social a:hover {
    background: var(--color-coral);
    border-color: var(--color-coral);
    color: white;
  }

  .site-foot__col h4 {
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-accent);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-sunshine);
    font-weight: 700;
  }
  .site-foot__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
    font-size: 14px;
  }

  .site-foot__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255,255,255,0.12);
    flex-wrap: wrap;
  }
  .site-foot__legal { margin: 0; font-size: 12px; opacity: 0.55; }
  .site-foot__region select {
    background: transparent;
    border: 1.5px solid rgba(255,255,255,0.15);
    border-radius: 999px;
    padding: 6px 14px;
    color: var(--color-bg);
    font-family: var(--font-accent);
    font-size: 12px;
    outline: none;
    opacity: 0.75;
  }
  .site-foot__region select option { color: var(--color-ink); }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
</style>
