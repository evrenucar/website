---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Trans from '../components/Trans.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products'))
  .filter((p) => p.data.status !== 'archived')
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Canico Pets"
  description="Textile mats and pads for cats and dogs. Made at Aktunc Tekstil in Ankara."
  descriptionTr="Kediler ve köpekler için tekstil paspaslar ve pedler. Ankara'daki Aktunc Tekstil'de üretilir."
>

  {/* ---------- Hero ---------- */}
  <section class="home-hero">
    <div class="container home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow"><Trans en="Made in Ankara · Cats and dogs" tr="Ankara üretimi · Kedi ve köpek" /></p>
        <h1>
          <Trans en="Designed for pets." tr="Evcil hayvanlar için tasarlandı." /><br />
          <span class="hero-line-2"><Trans en="Made for modern homes." tr="Modern evler için üretildi." /></span>
        </h1>
        <p class="home-hero__lede">
          <Trans
            en="Canico Pets makes textile mats and pads for cats and dogs, produced at our own factory in Ankara. Simple, useful, and made to fit the home you already love."
            tr="Canico Pets, kediler ve köpekler için tekstil paspaslar ve pedler üretir. Üretim Ankara'daki kendi fabrikamızda yapılır. Sade, işlevsel ve sevdiğiniz eve yakışır."
          />
        </p>
        <div class="home-hero__ctas">
          <a class="btn btn--primary" href="/products"><Trans en="Shop the products" tr="Ürünlere göz atın" /></a>
          <a class="btn btn--ghost" href="/wholesale"><Trans en="For retailers" tr="Perakendeciler için" /></a>
        </div>
      </div>
      <div class="home-hero__media">
        <span class="home-hero__sticker" aria-hidden="true">FOR PETS. FOR LIFE.</span>
        <img
          src="https://images.unsplash.com/photo-1758607009173-01adaa43d8c0?auto=format&fit=crop&w=1200&q=80"
          alt="Tabby cat under a warm interior lamp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {/* ---------- Shop by pet: three solid colored tiles, no stock photos ---------- */}
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow"><Trans en="Shop" tr="Alışveriş" /></p>
          <h2><Trans en="Pick your household." tr="Hanenizi seçin." /></h2>
        </div>
        <a class="link-cta" href="/products"><Trans en="See everything" tr="Tümünü görün" /> ↗</a>
      </div>

      <div class="cat-tiles">
        <a class="cat-tile" href="/products" style="--tile:var(--color-coral);">
          <span class="cat-tile__eyebrow"><Trans en="For cats" tr="Kediler için" /></span>
          <h3><Trans en="Cats" tr="Kediler" /></h3>
          <p><Trans en="Litter mats and scratching pads that solve real problems without pet-shop plastic." tr="Kum paspasları ve tırmalama pedleri; pet shop plastiği olmadan gerçek çözümler." /></p>
          <span class="cat-tile__cta"><Trans en="Shop cats" tr="Kedi ürünleri" /> ↗</span>
        </a>
        <a class="cat-tile" href="/products" style="--tile:var(--color-lavender);">
          <span class="cat-tile__eyebrow"><Trans en="For dogs · coming soon" tr="Köpekler için · yakında" /></span>
          <h3><Trans en="Dogs" tr="Köpekler" /></h3>
          <p><Trans en="Feeding mats, floor protection, and travel pieces are in production on the same textile workflow." tr="Mama paspasları, zemin koruma ve seyahat parçaları aynı süreçte üretimde." /></p>
          <span class="cat-tile__cta"><Trans en="Preview the line" tr="Seriye göz atın" /> ↗</span>
        </a>
        <a class="cat-tile" href="/wholesale" style="--tile:var(--color-teal);">
          <span class="cat-tile__eyebrow"><Trans en="For retailers" tr="Perakendeciler için" /></span>
          <h3><Trans en="Wholesale" tr="Toptan" /></h3>
          <p><Trans en="Buy direct from the factory. MOQs, private label, and custom prints on request." tr="Doğrudan fabrikadan alım. MOQ, özel marka ve özel baskı talep üzerine." /></p>
          <span class="cat-tile__cta"><Trans en="Talk to us" tr="Bize ulaşın" /> ↗</span>
        </a>
      </div>
    </div>
  </section>

  {/* ---------- Featured products ---------- */}
  <section class="section" style="background: var(--color-bg-soft);">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow"><Trans en="The collection" tr="Koleksiyon" /></p>
          <h2><Trans en="Shipping today." tr="Bugün gönderime hazır." /></h2>
        </div>
        <a class="link-cta" href="/products"><Trans en="All products" tr="Tüm ürünler" /> ↗</a>
      </div>
      <div class="grid grid--3" style="margin-top: 32px;">
        {products.map((p) => (
          <ProductCard
            href={`/products/${p.slug}`}
            name={p.data.name}
            nameTr={p.data.name_tr}
            tagline={p.data.tagline}
            taglineTr={p.data.tagline_tr}
            image={p.data.images[0]}
            status={p.data.status === 'available' ? 'available' : 'coming-soon'}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ---------- Benefits row: colored accent, no emoji ---------- */}
  <section class="section">
    <div class="container">
      <p class="eyebrow"><Trans en="Why Canico" tr="Neden Canico" /></p>
      <h2><Trans en="What every mat we ship has in common." tr="Her paspasımızın ortak yönleri." /></h2>
      <div class="benefits">
        <div class="benefit" style="--accent: var(--color-coral);">
          <span class="benefit__num">01</span>
          <h4><Trans en="In-house factory" tr="Kendi fabrikamız" /></h4>
          <p><Trans en="Print, cut, sew, and finish at Aktunc Tekstil in Ankara." tr="Baskı, kesim, dikim ve bitirme Ankara'daki Aktunc Tekstil'de." /></p>
        </div>
        <div class="benefit" style="--accent: var(--color-lavender);">
          <span class="benefit__num">02</span>
          <h4><Trans en="Textile face" tr="Tekstil yüzey" /></h4>
          <p><Trans en="Loop-pile face for litter. Natural fiber face for scratching." tr="Kum için petek yüzey. Tırmalama için doğal elyaf yüzey." /></p>
        </div>
        <div class="benefit" style="--accent: var(--color-teal);">
          <span class="benefit__num">03</span>
          <h4><Trans en="Machine washable" tr="Makinede yıkanır" /></h4>
          <p><Trans en="Cold wash, air dry. Bound edges survive repeat washes." tr="Soğuk yıkama, doğal kuruma. Bantlı kenarlar yıkamalara dayanır." /></p>
        </div>
        <div class="benefit" style="--accent: var(--color-sunshine);">
          <span class="benefit__num">04</span>
          <h4><Trans en="Custom runs" tr="Özel üretim" /></h4>
          <p><Trans en="Sizes, prints, packaging on request. Standard for private label." tr="Boyut, baskı, ambalaj talep üzerine. Özel markada standart." /></p>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- Story block: single landscape photo, side-by-side copy ---------- */}
  <section class="section" style="background: var(--color-bg-warm);">
    <div class="container story">
      <div class="story__media">
        <img
          src="https://images.unsplash.com/photo-1496416889320-d7f26667c8d5?auto=format&fit=crop&w=1400&q=80"
          alt="White cat at a stainless steel bowl in a warm interior"
          loading="lazy"
        />
      </div>
      <div class="story__copy">
        <p class="eyebrow"><Trans en="Our story" tr="Hikayemiz" /></p>
        <h2><Trans en="A textile factory that started making pet products." tr="Evcil hayvan ürünleri yapmaya başlayan bir tekstil fabrikası." /></h2>
        <p>
          <Trans
            en="Aktunc Tekstil has been running a textile workshop in Ankara for years. Canico Pets is the pet-lifestyle brand built on that workflow. Sublimation printing, punching, and edge binding is what we do well, so that is what our first products are built from."
            tr="Aktunc Tekstil, Ankara'da yıllardır bir tekstil atölyesi işletiyor. Canico Pets, bu sürecin üzerine kurulmuş evcil hayvan yaşam markasıdır. Süblimasyon baskı, punç ve kenar bantlama iyi yaptığımız iş; ilk ürünlerimiz de buradan çıkıyor."
          />
        </p>
        <a class="btn btn--ghost" href="/about"><Trans en="More about us" tr="Daha fazla bilgi" /></a>
      </div>
    </div>
  </section>

  {/* ---------- Testimonials ---------- */}
  <section class="section">
    <div class="container">
      <div class="section-head" style="justify-content: center; text-align: center;">
        <div>
          <p class="eyebrow"><Trans en="From test households" tr="Test hanelerinden" /></p>
          <h2><Trans en="What early testers say." tr="İlk kullanıcılar ne diyor." /></h2>
        </div>
      </div>
      <div class="reviews">
        <figure class="review">
          <div class="review__stars" aria-label="5 out of 5">★★★★★</div>
          <blockquote>
            <Trans
              en="The floor around the litter box is finally clean. My cat walks right onto it and the mess just falls between the loops."
              tr="Kedi kumu kabının etrafındaki zemin sonunda temiz. Kedim doğrudan üzerinden geçiyor, kum petekler arasına düşüyor."
            />
          </blockquote>
          <figcaption>
            <span class="review__name">Ayşe K.</span>
            <span class="review__meta"><Trans en="Ankara · Cat household" tr="Ankara · Kedili ev" /></span>
          </figcaption>
        </figure>
        <figure class="review">
          <div class="review__stars" aria-label="5 out of 5">★★★★★</div>
          <blockquote>
            <Trans
              en="Put the scratching pad on the sofa arm and my cat used it the same day. The couch has looked untouched for two weeks."
              tr="Tırmalama pedini koltuğun koluna koydum, kedim aynı gün kullandı. İki haftadır koltuğa dokunulmamış gibi."
            />
          </blockquote>
          <figcaption>
            <span class="review__name">Mert D.</span>
            <span class="review__meta"><Trans en="Istanbul · Cat household" tr="İstanbul · Kedili ev" /></span>
          </figcaption>
        </figure>
        <figure class="review">
          <div class="review__stars" aria-label="5 out of 5">★★★★★</div>
          <blockquote>
            <Trans
              en="It looks like a rug, not a pet product. My guests didn't even notice it under the food bowls."
              tr="Halı gibi görünüyor, evcil hayvan ürünü değil. Misafirlerim mama kaplarının altında olduğunu fark etmedi bile."
            />
          </blockquote>
          <figcaption>
            <span class="review__name">Elif A.</span>
            <span class="review__meta"><Trans en="Izmir · Dog and cat household" tr="İzmir · Kedi ve köpekli ev" /></span>
          </figcaption>
        </figure>
      </div>
      <p class="reviews__note">
        <span class="placeholder-note"><Trans en="Placeholder" tr="Yer tutucu" /></span>
        <Trans en="Sample reviews for layout. Real quotes will replace these as they arrive." tr="Bu yorumlar düzen için örnektir. Gerçek yorumlar geldikçe değiştirilecek." />
      </p>
    </div>
  </section>

  {/* ---------- Wholesale CTA band ---------- */}
  <section class="section" style="background: var(--color-ink); color: var(--color-bg);">
    <div class="container">
      <div class="cta-band">
        <div class="cta-band__copy">
          <p class="eyebrow" style="color: var(--color-sunshine);"><Trans en="For retailers" tr="Perakendeciler için" /></p>
          <h2><Trans en="Selling pet accessories?" tr="Evcil hayvan aksesuarı mı satıyorsunuz?" /></h2>
          <p>
            <Trans
              en="We produce direct from Ankara. Wholesale, private label, and custom prints all start with the same conversation."
              tr="Ankara'dan doğrudan üretim yaparız. Toptan, özel marka ve özel baskı, hepsi aynı görüşmeyle başlar."
            />
          </p>
        </div>
        <div class="cta-band__ctas">
          <a class="btn btn--primary" href="/wholesale" style="background: var(--color-coral);"><Trans en="Wholesale details" tr="Toptan detayları" /></a>
          <a class="btn btn--ghost" href="/contact" style="border-color: white; color: white;"><Trans en="Contact us" tr="Bize ulaşın" /></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-line-2 { color: var(--color-coral); }
  .home-hero__lede {
    font-size: 1.15rem;
    color: var(--color-ink-soft);
    max-width: 52ch;
    margin-block: var(--space-4) var(--space-5);
  }
  .home-hero__ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }
  .link-cta {
    text-decoration: none;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 14px;
    color: var(--color-coral);
    letter-spacing: 0.5px;
    white-space: nowrap;
  }
  .link-cta:hover { color: var(--color-ink); }

  /* Category tiles: solid color, generous type, no photos. */
  .cat-tiles {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .cat-tiles { grid-template-columns: repeat(3, 1fr); }
  }
  .cat-tile {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--tile);
    color: var(--color-ink);
    text-decoration: none;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    aspect-ratio: 3 / 4;
    transition: transform 220ms ease, box-shadow 220ms ease;
    position: relative;
    overflow: hidden;
  }
  .cat-tile:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    color: var(--color-ink);
  }
  .cat-tile__eyebrow {
    font-family: var(--font-accent);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-ink);
    opacity: 0.75;
    margin-bottom: 6px;
    display: block;
  }
  .cat-tile h3 {
    color: var(--color-ink);
    margin: 0 0 12px 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 0.95;
  }
  .cat-tile p {
    margin: 0 0 var(--space-4) 0;
    font-size: 14px;
    color: var(--color-ink);
    opacity: 0.85;
    line-height: 1.45;
    max-width: 32ch;
  }
  .cat-tile__cta {
    font-family: var(--font-accent);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 14px;
    background: rgba(0,0,0,0.08);
    border-radius: 999px;
    align-self: flex-start;
    transition: background 140ms ease;
  }
  .cat-tile:hover .cat-tile__cta {
    background: var(--color-ink);
    color: var(--tile);
  }

  /* Benefits: numbered, colored accent, no emoji */
  .benefits {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    margin-top: var(--space-5);
  }
  @media (min-width: 720px) { .benefits { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .benefits { grid-template-columns: repeat(4, 1fr); } }
  .benefit {
    padding: var(--space-5);
    background: white;
    border: 1.5px solid var(--color-line);
    border-top: 4px solid var(--accent, var(--color-coral));
    border-radius: var(--radius-lg);
  }
  .benefit__num {
    font-family: var(--font-accent);
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--accent, var(--color-coral));
    font-weight: 700;
    display: block;
    margin-bottom: 12px;
  }
  .benefit h4 { margin: 0 0 8px; font-size: 17px; font-weight: 700; }
  .benefit p { margin: 0; font-size: 14px; color: var(--color-ink-soft); line-height: 1.5; }

  /* Story block: landscape image, wider spacing */
  .story {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .story { grid-template-columns: 1.15fr 1fr; }
  }
  .story__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-soft);
  }
  .story__media img { width: 100%; height: 100%; object-fit: cover; }
  .story__copy .btn { margin-top: var(--space-3); }

  /* Reviews */
  .reviews {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    margin-top: var(--space-5);
  }
  @media (min-width: 720px) {
    .reviews { grid-template-columns: repeat(3, 1fr); }
  }
  .review {
    margin: 0;
    padding: var(--space-5);
    background: white;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-lg);
  }
  .review__stars {
    color: var(--color-sunshine);
    letter-spacing: 3px;
    font-size: 16px;
    margin-bottom: 12px;
  }
  .review blockquote {
    margin: 0 0 16px 0;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-ink);
  }
  .review figcaption {
    display: flex;
    flex-direction: column;
    font-size: 13px;
  }
  .review__name { font-weight: 700; color: var(--color-ink); }
  .review__meta { color: var(--color-muted); }
  .reviews__note {
    text-align: center;
    margin-top: var(--space-5);
    color: var(--color-muted);
    font-size: 13px;
  }

  /* CTA band */
  .cta-band {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .cta-band { grid-template-columns: 1.4fr auto; }
  }
  .cta-band__copy h2 { color: var(--color-bg); }
  .cta-band__copy p { color: rgba(255,255,255,0.75); margin: 0; max-width: 60ch; }
  .cta-band__ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }
</style>
