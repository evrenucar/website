---
import BaseLayout from '../layouts/BaseLayout.astro';
import Trans from '../components/Trans.astro';
---
<BaseLayout title="Privacy" titleTr="Gizlilik" description="Privacy notice for canicopet.com." descriptionTr="canicopet.com gizlilik bildirimi.">
  <section class="section">
    <div class="container container--narrow">
      <p class="eyebrow"><Trans en="Privacy" tr="Gizlilik" /></p>
      <h1><Trans en="Privacy notice" tr="Gizlilik bildirimi" /></h1>
      <p class="placeholder-note">
        <Trans en="Placeholder. Replace with legally reviewed copy before launch." tr="Yer tutucu. Yayın öncesi hukuki incelemeden geçmiş metinle değiştirilecek." />
      </p>

      <h2><Trans en="What we collect" tr="Toplanan Veriler" /></h2>
      <p>
        <Trans
          en="canicopet.com is a static marketing site. It does not collect personal data through forms or accounts. If you email us, we use your email address only to reply."
          tr="canicopet.com statik bir tanıtım sitesidir. Sitemizde kullanıcı hesabı veya form yoluyla kişisel veri toplanmamaktadır. Bize e-posta ile ulaştığınızda, adresiniz yalnızca talebinize yanıt vermek amacıyla kullanılır."
        />
      </p>

      <h2><Trans en="Analytics" tr="Analiz ve İstatistik" /></h2>
      <p>
        <Trans
          en="If we add analytics later (for example Plausible or Fathom), this page will list what is collected and how to opt out."
          tr="Sitemizde ileride gizlilik odaklı analitik araçları kullanılması durumunda, toplanan anonim verilerin kapsamı bu sayfada açıkça ilan edilecektir."
        />
      </p>

      <h2><Trans en="Cookies" tr="Çerez Politikası" /></h2>
      <p><Trans en="This site does not set cookies." tr="Web sitemizde herhangi bir çerez (cookie) kullanılmamaktadır." /></p>

      <h2><Trans en="External Services & Fonts" tr="Dış Hizmetler ve Yazı Tipleri" /></h2>
      <p>
        <Trans
          en="All fonts, images, and assets are hosted locally on our own origin. This website does not make requests to third-party CDNs, external font providers, or external tracking services."
          tr="Web sitemizdeki tüm yazı tipleri, görseller ve kaynaklar doğrudan kendi sunucumuzda yerel olarak barındırılmaktadır. Sitemiz üçüncü taraf CDN'lere, dış yazı tipi sağlayıcılarına veya harici takip servislerine herhangi bir veri isteği göndermez."
        />
      </p>

      <h2><Trans en="Contact" tr="İletişim" /></h2>
      <p>
        <Trans en="For privacy inquiries, contact us at" tr="Gizlilik ile ilgili sorularınız için:" /> <a href="mailto:info@canicopet.com">info@canicopet.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
