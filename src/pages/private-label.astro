---
import BaseLayout from '../layouts/BaseLayout.astro';
import Trans from '../components/Trans.astro';
import ContactChannels from '../components/ContactChannels.astro';
---
<BaseLayout
  title="Private label pet products manufacturer"
  titleTr="Özel marka üretim"
  description="Private-label litter mats and pet textiles, produced under your brand at our factory in Ankara. Sublimation print, low MOQs."
  descriptionTr="Özel markanız altında üretilen kedi paspasları ve tekstil evcil hayvan ürünleri. Üretim Ankara'daki fabrikamızda."
>
  <section class="section">
    <div class="container container--narrow">
      <p class="eyebrow"><Trans en="Private Label" tr="Özel Marka" /></p>
      <h1><Trans en="Private-label production for pet brands." tr="Evcil hayvan markaları için özel marka üretim." /></h1>
      <p class="lede">
        <Trans
          en="You design the product; we manufacture it in Ankara. Sizes, prints, packaging, and labels can be adjusted per order."
          tr="Ürünü siz tasarlarsınız, biz Ankara'da üretiriz. Boyut, baskı, ambalaj ve etiket sipariş bazında ayarlanabilir."
        />
      </p>

      <h2><Trans en="How it works" tr="Nasıl işliyor" /></h2>
      <ol>
        <li><Trans en="Send us a brief: product, sizes, colors, target price." tr="Bize bir brief gönderin: ürün, boyut, renk, hedef fiyat." /></li>
        <li><Trans en="We reply with spec, MOQ, timeline, and pricing." tr="Spesifikasyon, MOQ, zamanlama ve fiyatla döneriz." /></li>
        <li><Trans en="We produce a sample. You approve it or ask for changes." tr="Bir numune üretiriz. Onaylarsınız ya da değişiklik istersiniz." /></li>
        <li><Trans en="We produce your run in Ankara." tr="Üretiminizi Ankara'da yaparız." /></li>
        <li><Trans en="We ship direct to your warehouse." tr="Doğrudan deponuza sevkiyat yaparız." /></li>
      </ol>

      <h2><Trans en="What we can customize" tr="Neleri özelleştirebiliriz" /></h2>
      <ul>
        <li><Trans en="Sizes and cuts to your spec" tr="Sizin spesifikasyonunuza göre boyut ve kesim" /></li>
        <li><Trans en="Prints and colors from your artwork" tr="Sizin görselinizden baskı ve renk" /></li>
        <li><Trans en="Your logo on labels, packaging, and tags" tr="Etiket, ambalaj ve tag üzerinde logonuz" /></li>
        <li><Trans en="Custom packaging design" tr="Özel ambalaj tasarımı" /></li>
      </ul>

      <h2><Trans en="Start a conversation" tr="Görüşme başlatın" /></h2>
      <ContactChannels variant="wholesale" />
    </div>
  </section>
</BaseLayout>

<style>
  .lede { font-size: 1.15rem; color: var(--color-ink-soft); max-width: 60ch; }
  h2 { margin-top: var(--space-6); }
</style>
