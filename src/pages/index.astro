---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Trans from '../components/Trans.astro';
import { Image } from 'astro:assets';
import { base } from '../lib/paths';
import { getCollection } from 'astro:content';
import { getVariantAssets } from '../lib/variants';
import carouselScratchingPad from '../assets/site/carousel-scratching-pad.webp';
import carouselLitterMat from '../assets/site/carousel-litter-mat.webp';
import carouselTabbyCat from '../assets/site/carousel-tabby-cat.webp';
import storyCatAtBowl from '../assets/site/story-cat-at-bowl.webp';

const rawProducts = (await getCollection('products'))
  .filter((p) => p.data.status !== 'archived')
  .sort((a, b) => a.data.order - b.data.order);

const featuredProducts = rawProducts.map((p) => {
  const heroImage = p.data.images[0];
  const variantItems = p.data.variants
    .map((v) => {
      const assets = getVariantAssets(p.id, v.sku, heroImage);
      return assets.thumbnail ? { image: assets.thumbnail, sku: v.sku } : null;
    })
    .filter((item): item is NonNullable<typeof item> => Boolean(item));

  return {
    id: p.id,
    name: p.data.name,
    nameTr: p.data.name_tr,
    tagline: p.data.tagline,
    taglineTr: p.data.tagline_tr,
    heroImage,
    variantItems,
    sizeCount: p.data.sizes.length,
    variantCount: p.data.variants.length,
    status: (p.data.status === 'available' ? 'available' : 'coming-soon') as 'available' | 'coming-soon',
  };
});

const siteUrl = Astro.site ? new URL(base + '/', Astro.site).toString() : '';
const logoUrl = Astro.site ? new URL(`${base}/caniko_logo_dark_color1080.png`, Astro.site).toString() : '';
---
<BaseLayout
  title="Canico Pet"
  titleTr="Canico Pet"
  description="Machine-washable cat litter mats and couch-arm scratching pads. Textile, not plastic. Made at Aktunc Tekstil in Ankara."
  descriptionTr="Makinede yıkanabilir kedi kumu paspasları ve koltuk kolu tırmalama pedleri. Plastik değil, tekstil. Ankara'daki Aktunc Tekstil'de üretilir."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Canico Pet',
    url: siteUrl,
    logo: logoUrl,
  })} />

  {/* ---------- Full-width carousel ---------- */}
  <section class="home-carousel" aria-roledescription="carousel" aria-label="Featured">
    <h1 class="visually-hidden">
      <Trans
        en="Canico Pet · Machine-washable cat litter mats and scratching pads"
        tr="Canico Pet · Yıkanabilir kedi kumu paspasları ve tekstil ürünleri"
      />
    </h1>
    <ul class="home-carousel__track" tabindex="0">
      <li class="home-carousel__slide" id="home-slide-0" role="tabpanel" aria-labelledby="home-dot-0" aria-roledescription="slide" aria-label="1 of 3">
        <a href={`${base}/products/litter-mat`} class="home-carousel__link" aria-label="Cat Litter Collecting Mat" draggable="false">
          <Image
            src={carouselLitterMat}
            alt="Cat stepping off a textile mat next to a litter box"
            loading="eager"
            fetchpriority="high"
            draggable="false"
          />
        </a>
        <div class="home-carousel__caption">
          <h2>
            <a href={`${base}/products/litter-mat`}>
              <Trans en="Cat Litter Collecting Mat" tr="Kedi Kumu Paspası" />
            </a>
          </h2>
          <p><Trans en="Catches litter before it reaches the floor." tr="Kumu yere dağılmadan yakalar, temizliği kolaylaştırır." /></p>
        </div>
      </li>
      <li class="home-carousel__slide" id="home-slide-1" role="tabpanel" aria-labelledby="home-dot-1" aria-roledescription="slide" aria-label="2 of 3">
        <a href={`${base}/products/scratching-pad`} class="home-carousel__link" aria-label="Couch-Arm Scratching Pad" draggable="false">
          <Image
            src={carouselScratchingPad}
            alt="Cat scratching a textile pad on a sofa arm"
            loading="lazy"
            fetchpriority="low"
            draggable="false"
          />
        </a>
        <div class="home-carousel__caption">
          <h2>
            <a href={`${base}/products/scratching-pad`}>
              <Trans en="Couch-Arm Scratching Pad" tr="Kedi Koltuk Tırmalama Koruyucu Matı" />
            </a>
          </h2>
          <p><Trans en="A scratcher that sits on the corner your cat already picks." tr="Kedinizin zaten tırmaladığı koltuk köşeleri için özel koruyucu ped." /></p>
        </div>
      </li>
      <li class="home-carousel__slide" id="home-slide-2" role="tabpanel" aria-labelledby="home-dot-2" aria-roledescription="slide" aria-label="3 of 3">
        <Image
          src={carouselTabbyCat}
          alt="Tabby cat under a warm interior lamp"
          loading="lazy"
          fetchpriority="low"
          draggable="false"
        />
        <div class="home-carousel__caption">
          <h2>
            <Trans en="For pets, for life." tr="For pets, for life." />
          </h2>
          <p>
            <Trans
              en="Textile mats and pads for cats and dogs. Made at Aktunc Tekstil in Ankara."
              tr="Kedi ve köpekler için dayanıklı tekstil paspasları. Ankara'daki atölyemizde üretiyoruz."
            />
          </p>
        </div>
      </li>
    </ul>
    <div class="home-carousel__dots" role="tablist" aria-label="Select slide">
      <button type="button" role="tab" id="home-dot-0" aria-controls="home-slide-0" aria-label="Slide 1" aria-selected="true" tabindex="0" data-slide="0"></button>
      <button type="button" role="tab" id="home-dot-1" aria-controls="home-slide-1" aria-label="Slide 2" aria-selected="false" tabindex="-1" data-slide="1"></button>
      <button type="button" role="tab" id="home-dot-2" aria-controls="home-slide-2" aria-label="Slide 3" aria-selected="false" tabindex="-1" data-slide="2"></button>
    </div>
  </section>

  <script is:inline data-astro-rerun>
    (function () {
      var track = document.querySelector('.home-carousel__track');
      var dots = document.querySelectorAll('.home-carousel__dots button');
      var dotsContainer = document.querySelector('.home-carousel__dots');
      if (!track || !dots.length) return;
      var slides = track.children.length;
      var i = 0;
      var timer;
      var isDragging = false;
      var startX = 0;
      var scrollStart = 0;
      var dragDelta = 0;
      var startTime = 0;

      function go(n, focusTab) {
        i = (n + slides) % slides;
        track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
        dots.forEach(function (d, k) {
          var isSelected = k === i;
          d.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          d.setAttribute('tabindex', isSelected ? '0' : '-1');
          if (isSelected && focusTab) d.focus();
        });
      }

      function start() {
        stop();
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        timer = setInterval(function () { go(i + 1); }, 15000);
      }
      function stop() { if (timer) clearInterval(timer); }

      dots.forEach(function (d) {
        d.addEventListener('click', function () { go(parseInt(d.dataset.slide, 10)); start(); });
      });

      if (dotsContainer) {
        dotsContainer.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            go(i + 1, true);
            start();
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            go(i - 1, true);
            start();
          } else if (e.key === 'Home') {
            e.preventDefault();
            go(0, true);
            start();
          } else if (e.key === 'End') {
            e.preventDefault();
            go(slides - 1, true);
            start();
          }
        });
      }

      track.addEventListener('focusin', stop);
      track.addEventListener('focusout', start);

      var isDown = false;
      var isDragging = false;
      var hasDragged = false;
      var startX = 0;
      var scrollStart = 0;
      var dragDelta = 0;
      var startTime = 0;
      var rafId = null;

      // Prevent native browser drag-and-drop on images/links so custom pointer dragging works
      track.addEventListener('dragstart', function (e) {
        e.preventDefault();
      });

      // Pointer interaction: distinguish clean clicks from intentional drags
      track.addEventListener('pointerdown', function (e) {
        if (e.button !== 0) return;
        if (e.target.closest('button')) return;
        stop();
        isDown = true;
        isDragging = false;
        hasDragged = false;
        startX = e.clientX;
        scrollStart = track.scrollLeft;
        dragDelta = 0;
        startTime = Date.now();
      });

      track.addEventListener('pointermove', function (e) {
        if (!isDown) return;
        var delta = e.clientX - startX;
        dragDelta = delta;

        // Engage drag mode only once movement exceeds 8px threshold
        if (!isDragging) {
          if (Math.abs(delta) > 8) {
            isDragging = true;
            hasDragged = true;
            track.style.cursor = 'grabbing';
            track.style.scrollBehavior = 'auto';
            track.style.scrollSnapType = 'none';
            try { track.setPointerCapture(e.pointerId); } catch (_) {}
          } else {
            return;
          }
        }

        if (!rafId) {
          rafId = requestAnimationFrame(function () {
            track.scrollLeft = scrollStart - dragDelta;
            rafId = null;
          });
        }
      });

      function endDrag(e) {
        if (!isDown) return;
        isDown = false;

        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }

        // Only snap/scroll if user was actually dragging
        if (isDragging) {
          isDragging = false;
          track.style.cursor = '';
          track.style.scrollBehavior = 'smooth';
          track.style.scrollSnapType = 'x mandatory';
          try { if (track.hasPointerCapture(e.pointerId)) track.releasePointerCapture(e.pointerId); } catch (_) {}

          var duration = Date.now() - startTime;
          var velocity = Math.abs(dragDelta) / Math.max(duration, 1);

          if (dragDelta < -40 || (dragDelta < -20 && velocity > 0.3)) {
            go(i + 1);
          } else if (dragDelta > 40 || (dragDelta > 20 && velocity > 0.3)) {
            go(i - 1);
          } else {
            go(i);
          }
          start();
        }
      }

      track.addEventListener('pointerup', endDrag);
      track.addEventListener('pointercancel', endDrag);

      // Prevent link navigation only when user actually performed a drag gesture
      track.addEventListener('click', function (e) {
        if (hasDragged) {
          e.preventDefault();
          e.stopPropagation();
          hasDragged = false;
        }
      }, true);

      var syncing;
      track.addEventListener('scroll', function () {
        if (isDragging) return;
        clearTimeout(syncing);
        syncing = setTimeout(function () {
          var k = Math.round(track.scrollLeft / track.clientWidth);
          if (k !== i) {
            i = k;
            dots.forEach(function (d, m) { d.setAttribute('aria-selected', m === i ? 'true' : 'false'); });
          }
        }, 120);
      }, { passive: true });

      start();

      document.addEventListener('astro:before-swap', function () {
        stop();
      }, { once: true });
    })();
  </script>

  {/* ---------- Shop by pet: three solid colored tiles, no stock photos ---------- */}
  <section class="section section-deferred">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow"><Trans en="Shop" tr="Kategoriler" /></p>
          <h2><Trans en="Pick your household." tr="Kimin için bakıyorsunuz?" /></h2>
        </div>
        <a class="link-cta" href={`${base}/products`}><Trans en="See everything" tr="Tüm Ürünler" /> <span aria-hidden="true">↗</span></a>
      </div>

      <div class="cat-tiles">
        <a class="cat-tile" href={`${base}/products`} style="--tile:var(--color-coral);">
          <svg class="cat-tile__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M96,140a12,12,0,1,1-12-12A12,12,0,0,1,96,140Zm76-12a12,12,0,1,0,12,12A12,12,0,0,0,172,128Zm60-80v88c0,52.93-46.65,96-104,96S24,188.93,24,136V48A16,16,0,0,1,51.31,36.69c.14.14.26.27.38.41L69,57a111.22,111.22,0,0,1,118.1,0L204.31,37.1c.12-.14.24-.27.38-.41A16,16,0,0,1,232,48Zm-16,0-21.56,24.8A8,8,0,0,1,183.63,74,88.86,88.86,0,0,0,168,64.75V88a8,8,0,1,1-16,0V59.05a97.43,97.43,0,0,0-16-2.72V88a8,8,0,1,1-16,0V56.33a97.43,97.43,0,0,0-16,2.72V88a8,8,0,1,1-16,0V64.75A88.86,88.86,0,0,0,72.37,74a8,8,0,0,1-10.81-1.17L40,48v88c0,41.66,35.21,76,80,79.67V195.31l-13.66-13.66a8,8,0,0,1,11.32-11.31L128,180.68l10.34-10.34a8,8,0,0,1,11.32,11.31L136,195.31v20.36c44.79-3.69,80-38,80-79.67Z"/></svg>
          <span class="cat-tile__eyebrow"><Trans en="For cats" tr="Kediler için" /></span>
          <h3><Trans en="Cats" tr="Kediler" /></h3>
          <p><Trans en="Litter mats and couch scratchers made with durable textiles, not flimsy plastic." tr="Plastik yerine dayanıklı tekstilden üretilen kedi kumu paspasları ve koltuk tırmalama pedleri." /></p>
          <span class="cat-tile__cta"><Trans en="Shop cats" tr="Ürünleri İnceleyin" /> <span aria-hidden="true">↗</span></span>
        </a>
        <a class="cat-tile" href={`${base}/products`} style="--tile:var(--color-lavender);">
          <svg class="cat-tile__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M239.71,125l-16.42-88a16,16,0,0,0-19.61-12.58l-.31.09L150.85,40h-45.7L52.63,24.56l-.31-.09A16,16,0,0,0,32.71,37.05L16.29,125a15.77,15.77,0,0,0,9.12,17.52A16.26,16.26,0,0,0,32.12,144,15.48,15.48,0,0,0,40,141.84V184a40,40,0,0,0,40,40h96a40,40,0,0,0,40-40V141.85a15.5,15.5,0,0,0,7.87,2.16,16.31,16.31,0,0,0,6.72-1.47A15.77,15.77,0,0,0,239.71,125ZM32,128h0L48.43,40,90.5,52.37Zm144,80H136V195.31l13.66-13.65a8,8,0,0,0-11.32-11.32L128,180.69l-10.34-10.35a8,8,0,0,0-11.32,11.32L120,195.31V208H80a24,24,0,0,1-24-24V123.11L107.92,56h40.15L200,123.11V184A24,24,0,0,1,176,208Zm48-80L165.5,52.37,207.57,40,224,128ZM104,140a12,12,0,1,1-12-12A12,12,0,0,1,104,140Zm72,0a12,12,0,1,1-12-12A12,12,0,0,1,176,140Z"/></svg>
          <span class="cat-tile__eyebrow"><Trans en="For dogs · coming soon" tr="Köpekler için · Yakında" /></span>
          <h3><Trans en="Dogs" tr="Köpekler" /></h3>
          <p><Trans en="Feeding mats, crate pads, and floor protection in production." tr="Mama matları, kafes pedleri ve zemin koruma örtüleri yakında sizlerle." /></p>
          <span class="cat-tile__cta"><Trans en="Preview the line" tr="Seriyi İnceleyin" /> <span aria-hidden="true">↗</span></span>
        </a>
        <a class="cat-tile" href={`${base}/wholesale`} style="--tile:var(--color-teal);">
          <svg class="cat-tile__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M232,96a7.89,7.89,0,0,0-.3-2.2L217.35,43.6A16.07,16.07,0,0,0,202,32H54A16.07,16.07,0,0,0,38.65,43.6L24.31,93.8A7.89,7.89,0,0,0,24,96h0v16a40,40,0,0,0,16,32v72a8,8,0,0,0,8,8H208a8,8,0,0,0,8-8V144a40,40,0,0,0,16-32V96ZM54,48H202l11.42,40H42.61Zm50,56h48v8a24,24,0,0,1-48,0Zm-16,0v8a24,24,0,0,1-35.12,21.26,7.88,7.88,0,0,0-1.82-1.06A24,24,0,0,1,40,112v-8ZM200,208H56V151.2a40.57,40.57,0,0,0,8,.8,40,40,0,0,0,32-16,40,40,0,0,0,64,0,40,40,0,0,0,32,16,40.57,40.57,0,0,0,8-.8Zm4.93-75.8a8.08,8.08,0,0,0-1.8,1.05A24,24,0,0,1,168,112v-8h48v8A24,24,0,0,1,204.93,132.2Z"/></svg>
          <span class="cat-tile__eyebrow"><Trans en="For retailers" tr="İşletmeler için" /></span>
          <h3><Trans en="Wholesale" tr="Toptan" /></h3>
          <p><Trans en="Direct from our Ankara workshop. Flexible MOQs, custom sizes, and tailored prints." tr="Ankara'daki atölyemizden doğrudan alım imkanı. Esnek sipariş adetleri, özel ölçü ve baskı seçenekleri." /></p>
          <span class="cat-tile__cta"><Trans en="Talk to us" tr="Teklif Alın" /> <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>
  </section>

  {/* ---------- Featured products ---------- */}
  <section class="section section--soft section-deferred">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow"><Trans en="The collection" tr="Öne Çıkanlar" /></p>
          <h2><Trans en="Shipping today." tr="Hemen Teslim Ürünler" /></h2>
        </div>
        <a class="link-cta" href={`${base}/products`}><Trans en="All products" tr="Tüm Ürünler" /> <span aria-hidden="true">↗</span></a>
      </div>
      <div class="grid grid--2">
        {featuredProducts.map((p) => (
          <ProductCard
            href={`${base}/products/${p.id}`}
            name={p.name}
            nameTr={p.nameTr}
            tagline={p.tagline}
            taglineTr={p.taglineTr}
            image={p.heroImage}
            gallery={p.variantItems}
            showDots={false}
            randomCycle={true}
            sizeCount={p.sizeCount}
            variantCount={p.variantCount}
            status={p.status}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ---------- Benefits row: colored accent, no emoji ---------- */}
  <section class="section section-deferred">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow"><Trans en="Why Canico" tr="Neden Canico?" /></p>
          <h2><Trans en="What every mat we ship has in common." tr="Ürünlerimizin öne çıkan özellikleri" /></h2>
        </div>
      </div>
      <div class="benefits">
        <div class="benefit" style="--accent: var(--color-coral);">
          <span class="benefit__num">01</span>
          <h3><Trans en="In-house factory" tr="Kendi Üretimimiz" /></h3>
          <p><Trans en="Printing, cutting, sewing, and edge binding all take place at Aktunc Tekstil in Ankara." tr="Baskı, kesim, dikim ve biye işlemlerinin tamamını Ankara'daki tesisimizde yapıyoruz." /></p>
        </div>
        <div class="benefit" style="--accent: var(--color-lavender);">
          <span class="benefit__num">02</span>
          <h3><Trans en="Textile face" tr="Tekstil Doku" /></h3>
          <p><Trans en="Dual-layer honeycomb mesh for litter. Natural fiber texture for scratching." tr="Kum tutucu petek dokulu yüzey ve mobilyaları koruyan doğal lifli tırmalama dokusu." /></p>
        </div>
        <div class="benefit" style="--accent: var(--color-teal);">
          <span class="benefit__num">03</span>
          <h3><Trans en="Easy to clean" tr="Kolay Temizlik" /></h3>
          <p><Trans en="Rinse or wash cold and air dry. Reinforced edge binding withstands repeat washing." tr="İster silkeleyin, ister yıkayın. Sağlam biye dikişleri sayesinde uzun ömürlüdür." /></p>
        </div>
        <div class="benefit" style="--accent: var(--color-sunshine);">
          <span class="benefit__num">04</span>
          <h3><Trans en="Custom runs" tr="Özel Üretim" /></h3>
          <p><Trans en="Tailored dimensions, custom surface prints, and bespoke packaging for wholesale clients." tr="Toptan siparişlerde isteğe göre özel ölçü, farklı desen baskısı ve ambalaj imkanı." /></p>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- Story block: single landscape photo, side-by-side copy ---------- */}
  <section class="section section--warm section-deferred">
    <div class="container story">
      <div class="story__media">
        <Image
          src={storyCatAtBowl}
          alt="White cat at a stainless steel bowl in a warm interior"
          loading="lazy"
        />
      </div>
      <div class="story__copy">
        <p class="eyebrow"><Trans en="Our story" tr="Hikayemiz" /></p>
        <h2><Trans en="A textile workshop since 1968." tr="1968'den gelen tekstil ustalığı" /></h2>
        <p>
          <Trans
            en="Aktunc Tekstil began in 1968 as a family furnishing business, incorporated in 1997 with a focus on contract flooring and industrial matting, and entered pet accessories in 2020. Today our workshop houses textile printing, precision die-cutting, and edge binding under one roof, with a monthly capacity of up to 20,000 mats."
            tr="1968 yılında bir aile mefruşat işletmesi olarak kurulan Aktunç Tekstil, 1997'de zemin kaplamaları ve endüstriyel paspas üretimiyle uzmanlığını genişletti; 2020'de ise bu tecrübesini evcil hayvan sektörüne taşıdı. Atölyemizde tekstil baskısı, kalıp kesim ve biye dikişini tek çatı altında yürütüyor, ayda 20.000 adede varan üretim kapasitesi sunuyoruz."
          />
        </p>
        <a class="btn btn--ghost" href={`${base}/about`}><Trans en="More about us" tr="Hakkımızda" /></a>
      </div>
    </div>
  </section>

  {/* ---------- Testimonials ---------- */}
  <section class="section section-deferred">
    <div class="container">
      <div class="section-head" style="justify-content: center; text-align: center;">
        <div>
          <p class="eyebrow"><Trans en="From customers" tr="Müşterilerimizden" /></p>
          <h2><Trans en="What our customers say." tr="Kullanıcı Deneyimleri" /></h2>
        </div>
      </div>
      <div class="reviews">
        <figure class="review">
          <div class="review__stars" aria-label="5 out of 5">★★★★★</div>
          <blockquote>
            <Trans
              en="The floor around the litter box is finally clean. My cat walks right onto it and the stray litter stays on the mat."
