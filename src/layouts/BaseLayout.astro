---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  titleTr?: string;
  description?: string;
  descriptionTr?: string;
  ogImage?: string;
}

const {
  title,
  titleTr,
  description = 'Textile mats and pads for cats and dogs. Made at Aktunc Tekstil in Ankara, Turkiye.',
  descriptionTr,
  ogImage = '/logo-placeholder.svg',
} = Astro.props;

const fullTitle = title === 'Canico Pets' ? title : `${title} · Canico Pets`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {titleTr && <meta name="title" data-lang="tr" content={`${titleTr} · Canico Pets`} />}
    <meta name="description" content={description} />
    {descriptionTr && <meta name="description" data-lang="tr" content={descriptionTr} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;700&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        try {
          var lang = localStorage.getItem('canico-lang') || 'en';
          if (lang === 'tr') {
            document.documentElement.classList.add('lang-tr');
            document.documentElement.lang = 'tr';
          }
        } catch (e) { /* localStorage unavailable; default to EN */ }
      })();
    </script>
  </head>
  <body>
    <Nav />
    <main id="content">
      <slot />
    </main>
    <Footer />

    <div id="egg-toast" class="egg-toast" role="status" aria-live="polite"></div>

    <script is:inline>
      (function () {
        var buttons = document.querySelectorAll('[data-lang-switch]');
        function setLang(lang) {
          var isTr = lang === 'tr';
          document.documentElement.classList.toggle('lang-tr', isTr);
          document.documentElement.lang = isTr ? 'tr' : 'en';
          try { localStorage.setItem('canico-lang', isTr ? 'tr' : 'en'); } catch (e) {}
          buttons.forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-lang-switch') === (isTr ? 'tr' : 'en') ? 'true' : 'false');
          });
        }
        buttons.forEach(function (b) {
          b.addEventListener('click', function () { setLang(b.getAttribute('data-lang-switch')); });
        });
        setLang(document.documentElement.classList.contains('lang-tr') ? 'tr' : 'en');
      })();
    </script>

    <script is:inline>
      // Easter egg 1: paw-print cursor trail. Runs only for the first 10 seconds
      // of active pointer movement, then quietly retires. Higher emit rate up
      // front so it's actually noticeable, then it fades out over the last 2s.
      // Disabled on touch devices and when the user prefers reduced motion.
      (function () {
        if (window.matchMedia('(hover: none)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var startedAt = 0;
        var lastEmit = 0;
        var pool = ['🐾', '🐾', '🐾', '🐾', '❤️'];

        document.addEventListener('pointermove', function (e) {
          var now = Date.now();
          if (!startedAt) startedAt = now;
          var elapsed = now - startedAt;
          if (elapsed > 10000) return; // 10-second window
          if (now - lastEmit < 55) return; // ~18/sec cap

          // Fade out the emit rate over the final 2 seconds
          var fade = elapsed < 8000 ? 1 : Math.max(0, 1 - (elapsed - 8000) / 2000);
          if (Math.random() > 0.65 * fade) return;

          lastEmit = now;
          var el = document.createElement('span');
          el.className = 'paw-print';
          el.textContent = pool[Math.floor(Math.random() * pool.length)];
          el.style.left = (e.clientX - 12) + 'px';
          el.style.top = (e.clientY - 12) + 'px';
          el.style.setProperty('--rot', (Math.random() * 60 - 30) + 'deg');
          document.body.appendChild(el);
          setTimeout(function () { el.remove(); }, 900);
        }, { passive: true });
      })();
    </script>

    <script is:inline>
      // Easter egg 2: Konami code → confetti of paw prints + toast.
      (function () {
        var seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
        var idx = 0;
        var toast = document.getElementById('egg-toast');
        function showToast(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.classList.add('is-visible');
          setTimeout(function () { toast.classList.remove('is-visible'); }, 3000);
        }
        function confetti() {
          var glyphs = ['🐾','🐈','🐕','❤️','⭐','🎾','🦴'];
          for (var i = 0; i < 60; i++) {
            (function (i) {
              setTimeout(function () {
                var el = document.createElement('span');
                el.className = 'paw-print';
                el.textContent = glyphs[Math.floor(Math.random() * glyphs.length)];
                el.style.left = (Math.random() * window.innerWidth) + 'px';
                el.style.top = '-30px';
                el.style.fontSize = (18 + Math.random() * 22) + 'px';
                el.style.setProperty('--rot', (Math.random() * 720 - 360) + 'deg');
                el.style.animation = 'paw-fall ' + (1600 + Math.random() * 1500) + 'ms cubic-bezier(.4,.2,.6,1) forwards';
                document.body.appendChild(el);
                setTimeout(function () { el.remove(); }, 3200);
              }, i * 30);
            })(i);
          }
        }
        var style = document.createElement('style');
        style.textContent = '@keyframes paw-fall { from { transform: translateY(0) rotate(0); opacity: 1; } to { transform: translateY(110vh) rotate(var(--rot,720deg)); opacity: 0.5; } }';
        document.head.appendChild(style);

        window.addEventListener('keydown', function (e) {
          if (e.key === seq[idx]) {
            idx += 1;
            if (idx === seq.length) {
              idx = 0;
              var isTr = document.documentElement.classList.contains('lang-tr');
              showToast(isTr ? 'Miyav! 🐾' : 'Meow! 🐾');
              confetti();
            }
          } else {
            idx = e.key === seq[0] ? 1 : 0;
          }
        });
      })();
    </script>
  </body>
</html>
