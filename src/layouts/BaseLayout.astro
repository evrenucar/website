---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { base } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title: string;
  titleTr?: string;
  description?: string;
  descriptionTr?: string;
  ogImage?: string;
}

const {
  title,
  titleTr,
  description = 'Machine-washable textile litter mats and scratching pads for cats and dogs. Made at Aktunc Tekstil in Ankara, Turkiye.',
  descriptionTr,
  ogImage = `${base}/og.png`,
} = Astro.props;

const fullTitle = title === 'Canico Pet' ? title : `${title} · Canico Pet`;
const fullTitleTr = titleTr ? (titleTr === 'Canico Pet' ? titleTr : `${titleTr} · Canico Pet`) : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// og:image must be an absolute URL; most platforms also refuse SVG previews.
const ogImageAbs = new URL(ogImage, Astro.site).toString();
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {fullTitleTr && <meta name="title" data-lang="tr" content={fullTitleTr} />}
    <meta name="description" content={description} />
    {descriptionTr && <meta name="description" data-lang="tr" content={descriptionTr} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}/favicon-48x48.png`} />
    <link rel="icon" type="image/png" sizes="256x256" href={`${base}/favicon-256x256.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/favicon-180x180.png`} />

    <link rel="preload" as="image" href={`${base}/caniko_logo_dark_color1080.png`} fetchpriority="high" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;700&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        // Priority: user's saved choice > browser languages > default EN.
        try {
          var saved = localStorage.getItem('canico-lang');
          var lang = saved;
          if (!lang) {
            var prefs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en']);
            for (var i = 0; i < prefs.length; i++) {
              var p = (prefs[i] || '').toLowerCase();
              if (p.indexOf('tr') === 0) { lang = 'tr'; break; }
              if (p.indexOf('en') === 0) { lang = 'en'; break; }
            }
            if (!lang) lang = 'en';
          }
          if (lang === 'tr') {
            document.documentElement.classList.add('lang-tr');
            document.documentElement.lang = 'tr';
          }
        } catch (e) { /* localStorage unavailable; default to EN */ }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#content" class="skip-link">
      <span lang="en">Skip to content</span>
      <span lang="tr">İçeriğe atla</span>
    </a>
    <Nav />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <div id="egg-toast" class="egg-toast" role="status" aria-live="polite"></div>

    <script is:inline>
      (function () {
        var buttons = document.querySelectorAll('[data-lang-switch]');
        var defaultTitle = document.title;
        var metaTitleTr = document.querySelector('meta[name="title"][data-lang="tr"]');
        var metaDesc = document.querySelector('meta[name="description"]:not([data-lang])');
        var metaDescTr = document.querySelector('meta[name="description"][data-lang="tr"]');
        var defaultDesc = metaDesc ? metaDesc.getAttribute('content') : '';

        function setLang(lang) {
          var isTr = lang === 'tr';
          document.documentElement.classList.toggle('lang-tr', isTr);
          document.documentElement.lang = isTr ? 'tr' : 'en';
          try { localStorage.setItem('canico-lang', isTr ? 'tr' : 'en'); } catch (e) {}
          buttons.forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-lang-switch') === (isTr ? 'tr' : 'en') ? 'true' : 'false');
          });
          if (isTr && metaTitleTr) {
            document.title = metaTitleTr.getAttribute('content') || defaultTitle;
          } else {
            document.title = defaultTitle;
          }
          if (metaDesc) {
            metaDesc.setAttribute('content', (isTr && metaDescTr) ? (metaDescTr.getAttribute('content') || defaultDesc) : defaultDesc);
          }
        }
        buttons.forEach(function (b) {
          b.addEventListener('click', function () { setLang(b.getAttribute('data-lang-switch')); });
        });
        setLang(document.documentElement.classList.contains('lang-tr') ? 'tr' : 'en');
      })();
    </script>

    <script is:inline>
      // Easter egg 1: paw-print cursor trail (Disabled).
      (function () {
        var ENABLE_CURSOR_TRAIL = false;
        if (!ENABLE_CURSOR_TRAIL) return;

        if (window.matchMedia('(hover: none)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var startedAt = 0;
        var lastEmit = 0;
        var pool = ['🐾', '🐾', '🐾', '🐾', '❤️'];

        function onPointerMove(e) {
          var now = Date.now();
          if (!startedAt) startedAt = now;
          var elapsed = now - startedAt;
          
          // Cleanup event listener after 10-second window to prevent memory/CPU waste (Issue #7)
          if (elapsed > 10000) {
            document.removeEventListener('pointermove', onPointerMove);
            return;
          }
          if (now - lastEmit < 55) return;

          var fade = elapsed < 8000 ? 1 : Math.max(0, 1 - (elapsed - 8000) / 2000);
          if (Math.random() > 0.65 * fade) return;

          lastEmit = now;
          var el = document.createElement('span');
          el.className = 'paw-print';
          el.textContent = pool[Math.floor(Math.random() * pool.length)];
          el.style.left = (e.clientX - 12) + 'px';
          el.style.top = (e.clientY - 12) + 'px';
          el.style.setProperty('--rot', (Math.random() * 60 - 30) + 'deg');
          document.body.appendChild(el);
          setTimeout(function () { el.remove(); }, 900);
        }

        document.addEventListener('pointermove', onPointerMove, { passive: true });
      })();
    </script>

    <script is:inline>
      // Easter egg 2: Konami code → confetti of paw prints + toast.
      (function () {
        var seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
        var idx = 0;
        var toast = document.getElementById('egg-toast');
        function showToast(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.classList.add('is-visible');
          setTimeout(function () { toast.classList.remove('is-visible'); }, 3000);
        }
        function confetti() {
          var glyphs = ['🐾','🐈','🐕','❤️','⭐','🎾','🦴'];
          for (var i = 0; i < 60; i++) {
            (function (i) {
              setTimeout(function () {
                var el = document.createElement('span');
                el.className = 'paw-print';
                el.textContent = glyphs[Math.floor(Math.random() * glyphs.length)];
                el.style.left = (Math.random() * window.innerWidth) + 'px';
                el.style.top = '-30px';
                el.style.fontSize = (18 + Math.random() * 22) + 'px';
                el.style.setProperty('--rot', (Math.random() * 720 - 360) + 'deg');
                el.style.animation = 'paw-fall ' + (1600 + Math.random() * 1500) + 'ms cubic-bezier(.4,.2,.6,1) forwards';
                document.body.appendChild(el);
                setTimeout(function () { el.remove(); }, 3200);
              }, i * 30);
            })(i);
          }
        }

        window.addEventListener('keydown', function (e) {
          if (e.key === seq[idx]) {
            idx += 1;
            if (idx === seq.length) {
              idx = 0;
              var isTr = document.documentElement.classList.contains('lang-tr');
              showToast(isTr ? 'Miyav! 🐾' : 'Meow! 🐾');
              confetti();
            }
          } else {
            idx = e.key === seq[0] ? 1 : 0;
          }
        });
      })();
    </script>
  </body>
</html>
