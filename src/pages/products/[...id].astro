---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Trans from '../../components/Trans.astro';
import { Image, getImage } from 'astro:assets';
import { base } from '../../lib/paths';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { formatDimension } from '../../lib/dimensions';
import { getVariantAssets } from '../../lib/variants';
import { RETAILER_REGISTRY, resolveRetailLinks } from '../../lib/retailers';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { Content } = await render(product);
const d = product.data;
const heroImage = d.images[0];

const heroRetailLinks = resolveRetailLinks(d.retail_links, null);

// Prepare all variants with resolved assets and formatted dimensions
const variantsWithAssets = d.variants.map((v) => {
  const sizeObj = d.sizes.find((s) => s.id === v.size_id);
  const assets = getVariantAssets(product.id, v.sku, heroImage);
  const swatchAspect = sizeObj
    ? `${Math.max(sizeObj.w, sizeObj.l)} / ${Math.min(sizeObj.w, sizeObj.l)}`
    : '1 / 1';
  const resolvedRetail = resolveRetailLinks(d.retail_links, v.retail_links);

  return {
    sku: v.sku,
    size_id: v.size_id,
    size_cm: sizeObj ? `${sizeObj.w}×${sizeObj.l}` : '',
    size_label: sizeObj ? formatDimension(sizeObj, 'cm') : '',
    size_label_in: sizeObj ? formatDimension(sizeObj, 'in') : '',
    status: v.status,
    price: v.price,
    retail_links: resolvedRetail,
    swatch_aspect: swatchAspect,
    thumbnail: assets.thumbnail,
    design: assets.design,
    gallery: assets.gallery,
  };
});

// Initial active variant (first variant or fallback)
const initialVariant = variantsWithAssets[0];
const initialSizeId = initialVariant ? initialVariant.size_id : d.sizes[0]?.id;
const initialRetailLinks = initialVariant ? initialVariant.retail_links : heroRetailLinks;
const hasInitialRetail = initialRetailLinks && Object.keys(initialRetailLinks).length > 0;
const fallbackGallery = initialVariant ? initialVariant.gallery : (d.images.length > 0 ? d.images : [heroImage].filter(Boolean));

// Sizes defined on the product
const allSizes = d.sizes;

// Pre-optimize gallery images for ultra-fast client-side switching (only optimized WebP URLs passed to client)
const variantsPayload = await Promise.all(
  variantsWithAssets.map(async (v) => {
    const optimizedGallery = await Promise.all(
      v.gallery.map(async (img) => {
        if (!img) return '';
        if (typeof img === 'string') return img;
        const opt = await getImage({ src: img, width: 800, height: 800, quality: 80, format: 'webp' });
        return opt.src;
      })
    );
    return {
      sku: v.sku,
      size_id: v.size_id,
      gallery: optimizedGallery,
      retail_links: v.retail_links,
    };
  })
);

const productCanonical = new URL(Astro.url.pathname, Astro.site).toString();
const heroImageAbs = heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Canico Pet ${d.name}`,
  description: d.description,
  brand: {
    '@type': 'Brand',
    name: 'Canico Pet',
  },
  category: 'Pet Supplies > Cat Supplies',
  url: productCanonical,
  image: heroImageAbs,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'TRY',
    availability: d.status === 'available' ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
    url: productCanonical,
  },
};
---
<BaseLayout
  title={d.name}
  titleTr={d.name_tr}
  description={d.tagline ?? d.description}
  descriptionTr={d.tagline_tr ?? d.description_tr}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <article class="section">
    <div class="container">
      <a href={`${base}/products`} class="back-link"><span aria-hidden="true">← </span><Trans en="All products" tr="Tüm Ürünler" /></a>

      <!-- Pre-rendered variant gallery JSON payload for instant synchronous client rendering -->
      <script is:inline type="application/json" id="variants-data" set:html={JSON.stringify(variantsPayload)} />

      <div class="product-hero" id="product-root">
        <!-- Media Hero & Gallery Carousel -->
        <div class="product-hero__media-col">
          <div class="product-hero__media" id="hero-media-container">
            <div class="variant-gallery is-active" id="active-gallery" data-sku={initialVariant?.sku}>
              {fallbackGallery.map((img, idx) => (
                <div class={`gallery-slide ${idx === 0 ? 'is-active' : ''}`} data-slide-idx={idx}>
                  {img && (
                    <Image
                      src={img}
                      alt={`${d.name} ${initialVariant?.sku ?? d.sku} photo ${idx + 1}`}
                      width={800}
                      height={800}
                      quality={80}
                      loading={idx === 0 ? 'eager' : 'lazy'}
                      fetchpriority={idx === 0 ? 'high' : undefined}
                      decoding="async"
                    />
                  )}
                </div>
              ))}
            </div>

            <div
              class="gallery-controls"
              id="gallery-controls"
              style={fallbackGallery.length > 1 ? '' : 'display: none;'}
            >
              <button type="button" class="gallery-btn gallery-btn--prev" id="gallery-prev-btn" aria-label="Previous image"><span aria-hidden="true">‹</span></button>
              <div class="gallery-dots" id="gallery-dots">
                {fallbackGallery.map((_, idx) => (
                  <button
                    type="button"
                    class={`dot ${idx === 0 ? 'is-active' : ''}`}
                    data-dot-idx={idx}
                    aria-label={`Go to slide ${idx + 1}`}
                  />
                ))}
              </div>
              <button type="button" class="gallery-btn gallery-btn--next" id="gallery-next-btn" aria-label="Next image"><span aria-hidden="true">›</span></button>
            </div>

            <span class="product-hero__badge" id="product-badge">
              {initialVariant?.status === 'available' || d.status === 'available' ? (
                <span class="badge-available"><Trans en="Available now" tr="Satışta" /></span>
              ) : (
                <span class="badge-coming"><Trans en="Coming soon" tr="Yakında" /></span>
              )}
            </span>
          </div>

          <div class="prose product-hero__prose">
            <Content />
          </div>
        </div>

        <!-- Product Specs & Interactive Pickers -->
        <div class="product-hero__body">
          <p class="eyebrow" id="active-sku-display">SKU {initialVariant?.sku ?? d.sku}</p>
          <h1>
            <span lang="en">{d.name}</span>{d.name_tr && <span lang="tr">{d.name_tr}</span>}
          </h1>
          {d.tagline && (
            <p class="lede">
              <span lang="en">{d.tagline}</span>{d.tagline_tr && <span lang="tr">{d.tagline_tr}</span>}
            </p>
          )}

          <!-- Retail / Marketplace Links -->
          {Object.keys(RETAILER_REGISTRY).length > 0 && (
            <div
              class="retail-section"
              id="retail-section"
            >
              <p
                class="retail-section__label"
                id="retail-section-label"
              >
                <Trans en="Online marketplaces:" tr="Pazaryerleri:" />
              </p>
              <div
                class="retail-links"
                id="retail-links-grid"
                style={hasInitialRetail ? '' : 'display: none;'}
              >
                {Object.values(RETAILER_REGISTRY).map((retailer) => {
                  const url = initialRetailLinks[retailer.id];
                  return (
                    <a
                      id={`retail-link-${retailer.id}`}
                      href={url || '#'}
                      target={retailer.isExternal !== false ? '_blank' : '_self'}
                      rel={retailer.isExternal !== false ? 'nofollow noopener noreferrer' : undefined}
                      class={`retail-badge retail-badge--${retailer.id}`}
                      style={url ? '' : 'display: none;'}
                      aria-label={retailer.name}
                      data-retailer-id={retailer.id}
                    >
                      <img
                        src={`${base}${retailer.logo}`}
                        alt={retailer.name}
                        width="124"
                        height="28"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  );
                })}
              </div>
              <div
                class="retail-empty-note"
                id="retail-empty-note"
                style={hasInitialRetail ? 'display: none;' : ''}
              >
                <svg class="retail-empty-note__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="12" y1="16" x2="12" y2="12" stroke-linecap="round" stroke-linejoin="round" />
                  <line x1="12" y1="8" x2="12.01" y2="8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="retail-empty-note__text">
                  <Trans
                    en="This variant is currently not available on online marketplaces. Contact us for stock availability and ordering information, or select a different variant."
                    tr="Bu seçenek şu anda pazaryerlerinde satışta değildir. Stok durumu ve sipariş bilgisi için bizimle iletişime geçebilir veya farklı bir seçenek belirleyebilirsiniz."
                  />
                </span>
              </div>
            </div>
          )}

          <div class="product-hero__ctas">
            <a class="btn btn--primary" href={`${base}/wholesale`}><Trans en="Wholesale Inquiry" tr="Toptan Teklif Alın" /></a>
            <a class="btn btn--ghost" id="product-contact-link" href={`${base}/contact`}><Trans en="Contact Us" tr="İletişime Geçin" /></a>
          </div>

          <!-- Size Selector (only rendered if there are multiple sizes to choose from) -->
          {allSizes.length > 1 && (
            <div class="picker-section">
              <p class="picker-label" id="size-picker-label">
                <Trans en="1. Select Size" tr="1. Ölçü Seçin" />
              </p>
              <div class="size-pill-group" role="radiogroup" aria-labelledby="size-picker-label">
                {allSizes.map((s) => {
                  const isAvailable = variantsWithAssets.length === 0 || variantsWithAssets.some((v) => v.size_id === s.id);
                  const isSelected = isAvailable && s.id === initialSizeId;
                  return (
                    <button
                      type="button"
                      class={`size-pill ${isSelected ? 'is-selected' : ''} ${!isAvailable ? 'size-pill--disabled' : ''}`}
                      data-size-id={s.id}
                      disabled={!isAvailable}
                      role="radio"
                      aria-checked={isSelected ? 'true' : 'false'}
                      aria-disabled={!isAvailable ? 'true' : 'false'}
                      tabindex={isSelected ? 0 : -1}
                    >
                      <span class="size-pill__cm">{formatDimension(s, 'cm')}</span>
                      <span class="size-pill__in">{formatDimension(s, 'in')}</span>
                      {!isAvailable && (
                        <span class="size-pill__tooltip" aria-hidden="true">
                          <Trans en="Coming soon" tr="Yakında" />
                        </span>
                      )}
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          <!-- Visual Design Palette -->
          {variantsWithAssets.length > 0 && (
            <div class="picker-section">
              <p class="picker-label" id="design-picker-label">
                {allSizes.length > 1 ? (
                  <Trans en="2. Select Print Design" tr="2. Desen Seçin" />
                ) : (
                  <Trans en="Select Print Design" tr="Desen Seçin" />
                )}
              </p>
              <div class="design-swatch-grid" role="radiogroup" aria-labelledby="design-picker-label">
                {variantsWithAssets.map((v) => {
                  const isSelected = v.sku === initialVariant?.sku;
                  const isVisible = v.size_id === initialSizeId;
                  return (
                    <button
                      type="button"
                      class={`design-swatch ${isSelected ? 'is-selected' : ''} ${!isVisible ? 'is-hidden' : ''}`}
                      data-sku={v.sku}
                      data-size-id={v.size_id}
                      role="radio"
                      aria-checked={isSelected ? 'true' : 'false'}
                      aria-label={`SKU ${v.sku}`}
                      title={`SKU ${v.sku}`}
                      tabindex={isSelected ? 0 : -1}
                      style={`--swatch-aspect: ${v.swatch_aspect};`}
                    >
                      <div class="design-swatch__thumb" style={`aspect-ratio: ${v.swatch_aspect};`}>
                        {v.design && (
                          <Image
                            src={v.design}
                            alt={`Design swatch for ${v.sku}`}
                            width={160}
                            quality={80}
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          {allSizes.length === 1 && (
            <div class="spec">
              <span class="spec__label"><Trans en="Dimensions" tr="Ölçüler" /></span>
              <span class="spec__value">
                {formatDimension(allSizes[0], 'cm')} ({formatDimension(allSizes[0], 'in')})
              </span>
            </div>
          )}

        </div>

        <!-- Inline synchronous parser script: Immediately updates gallery, SKU, size pills, and swatches BEFORE first paint -->
        <script is:inline data-astro-rerun>
          (function() {
            try {
              var sku = new URLSearchParams(window.location.search).get('sku');
              if (!sku) return;
              var dataEl = document.getElementById('variants-data');
              if (!dataEl) return;
              var variants = JSON.parse(dataEl.textContent || '[]');
              var v = variants.find(function(item) { return item.sku === sku; });
              if (!v) return;

              // 1. Immediately replace active gallery slides with target SKU slides before paint
              if (v.gallery && v.gallery.length > 0) {
                var gal = document.getElementById('active-gallery');
                if (gal) {
                  var html = '';
                  v.gallery.forEach(function(url, i) {
                    html += '<div class="gallery-slide' + (i === 0 ? ' is-active' : '') + '" data-slide-idx="' + i + '">' +
                      '<img src="' + url + '" alt="' + sku + ' photo ' + (i + 1) + '" ' + (i === 0 ? 'loading="eager" fetchpriority="high"' : 'loading="lazy"') + ' decoding="async" />' +
                      '</div>';
                  });
                  gal.innerHTML = html;
                  gal.setAttribute('data-sku', sku);
                }

                // 2. Immediately update controls / dots
                var ctrl = document.getElementById('gallery-controls');
                var dots = document.getElementById('gallery-dots');
                if (ctrl && dots) {
                  if (v.gallery.length > 1) {
                    ctrl.style.display = 'flex';
                    var dotsHtml = '';
                    for (var i = 0; i < v.gallery.length; i++) {
                      dotsHtml += '<button type="button" class="dot' + (i === 0 ? ' is-active' : '') + '" data-dot-idx="' + i + '" aria-label="Go to slide ' + (i + 1) + '"></button>';
                    }
                    dots.innerHTML = dotsHtml;
                  } else {
                    ctrl.style.display = 'none';
                    dots.innerHTML = '';
                  }
                }
              }

              // 3. Immediately update SKU text display
              var skuEl = document.getElementById('active-sku-display');
              if (skuEl) skuEl.textContent = 'SKU ' + sku;

              // 4. Immediately update size pills and swatches
              var sizeId = v.size_id;
              if (sizeId) {
                var pills = document.querySelectorAll('.size-pill:not([disabled])');
                pills.forEach(function(p) {
                  var isSel = Number(p.getAttribute('data-size-id')) === sizeId;
                  p.classList.toggle('is-selected', isSel);
                  p.setAttribute('aria-checked', isSel ? 'true' : 'false');
                  p.setAttribute('tabindex', isSel ? '0' : '-1');
                });

                var swatches = document.querySelectorAll('.design-swatch');
                swatches.forEach(function(s) {
                  var matchesSize = Number(s.getAttribute('data-size-id')) === sizeId;
                  var isSel = s.getAttribute('data-sku') === sku;
                  s.classList.toggle('is-hidden', !matchesSize);
                  s.classList.toggle('is-selected', isSel);
                  s.setAttribute('aria-checked', isSel ? 'true' : 'false');
                  s.setAttribute('tabindex', isSel ? '0' : '-1');
                });
              }

              // 5. Immediately update retail links
              var rLinks = v.retail_links || {};
              var hasAnyRetail = false;
              var badges = document.querySelectorAll('[data-retailer-id]');
              badges.forEach(function(badge) {
                var rid = badge.getAttribute('data-retailer-id');
                var url = rLinks[rid];
                if (url) {
                  badge.href = url;
                  badge.style.display = 'inline-flex';
                  hasAnyRetail = true;
                } else {
                  badge.style.display = 'none';
                }
              });
              var retailGrid = document.getElementById('retail-links-grid');
              var retailEmpty = document.getElementById('retail-empty-note');
              if (retailGrid) retailGrid.style.display = hasAnyRetail ? '' : 'none';
              if (retailEmpty) retailEmpty.style.display = hasAnyRetail ? 'none' : '';
            } catch(e) {}
          })();
        </script>
      </div>

    </div>
  </article>

</BaseLayout>

<script>
  // High-performance client-side variant picker and dynamic gallery controller
  function initVariantPicker() {
    const root = document.getElementById('product-root');
    if (!root) return;

    const variantsDataEl = document.getElementById('variants-data');
    const rawData = variantsDataEl ? JSON.parse(variantsDataEl.textContent || '[]') : [];
    const variantsMap = new Map<string, { sku: string; size_id: number; gallery: string[]; retail_links?: Record<string, string> }>();
    rawData.forEach((item: any) => variantsMap.set(item.sku, item));

    const sizePills = root.querySelectorAll<HTMLButtonElement>('.size-pill:not([disabled])');
    const designSwatches = root.querySelectorAll<HTMLButtonElement>('.design-swatch');
    const mediaContainer = document.getElementById('hero-media-container');
    let activeGalleryContainer = document.getElementById('active-gallery');
    const controlsContainer = document.getElementById('gallery-controls');
    const dotsContainer = document.getElementById('gallery-dots');
    const prevBtn = document.getElementById('gallery-prev-btn');
    const nextBtn = document.getElementById('gallery-next-btn');
    const skuDisplay = document.getElementById('active-sku-display');

    let activeSizeId: number = Number(root.querySelector('.size-pill.is-selected')?.getAttribute('data-size-id')) || 1;
    let activeSku: string = root.querySelector('.design-swatch.is-selected')?.getAttribute('data-sku') || '';

    let currentSlideIdx = 0;

    function showSlide(idx: number, animated = true) {
      const slides = activeGalleryContainer ? Array.from(activeGalleryContainer.querySelectorAll<HTMLElement>('.gallery-slide')) : [];
      const count = slides.length;
      if (count <= 0) return;
      currentSlideIdx = Math.max(0, Math.min(idx, count - 1));
      
      if (activeGalleryContainer) {
        activeGalleryContainer.style.transition = animated ? 'transform 320ms cubic-bezier(0.25, 1, 0.5, 1)' : 'none';
        activeGalleryContainer.style.transform = `translateX(-${currentSlideIdx * 100}%)`;
      }

      slides.forEach((s, i) => s.classList.toggle('is-active', i === currentSlideIdx));
      
      const dots = dotsContainer ? Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>('.dot')) : [];
      dots.forEach((d, i) => d.classList.toggle('is-active', i === currentSlideIdx));

      if (prevBtn) {
        (prevBtn as HTMLButtonElement).disabled = currentSlideIdx === 0;
        prevBtn.classList.toggle('is-disabled', currentSlideIdx === 0);
      }
      if (nextBtn) {
        (nextBtn as HTMLButtonElement).disabled = currentSlideIdx === count - 1;
        nextBtn.classList.toggle('is-disabled', currentSlideIdx === count - 1);
      }
    }

    function rebindDots() {
      if (!dotsContainer) return;
      dotsContainer.querySelectorAll<HTMLButtonElement>('.dot').forEach((dot) => {
        dot.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          const idx = Number(dot.getAttribute('data-dot-idx'));
          if (!isNaN(idx)) showSlide(idx, true);
        };
      });
    }

    const preloadedUrls = new Set<string>();

    function preloadImage(url: string): Promise<void> {
      if (!url) return Promise.resolve();
      if (preloadedUrls.has(url)) return Promise.resolve();
      return new Promise((resolve) => {
        const img = new Image();
        img.src = url;
        if (img.decode) {
          img.decode().then(() => {
            preloadedUrls.add(url);
            resolve();
          }).catch(() => {
            preloadedUrls.add(url);
            resolve();
          });
        } else {
          img.onload = () => {
            preloadedUrls.add(url);
            resolve();
          };
          img.onerror = () => {
            preloadedUrls.add(url);
            resolve();
          };
        }
      });
    }

    function preloadVariant(sku: string) {
      const variant = variantsMap.get(sku);
      if (!variant) return;
      variant.gallery.forEach((url) => {
        if (url) preloadImage(url);
      });
    }

    // Attach hover and focus precaching to design swatches and size pills
    designSwatches.forEach((swatch) => {
      const sku = swatch.getAttribute('data-sku');
      if (sku) {
        swatch.addEventListener('pointerenter', () => preloadVariant(sku));
        swatch.addEventListener('focus', () => preloadVariant(sku));
      }
    });

    sizePills.forEach((pill) => {
      pill.addEventListener('pointerenter', () => {
        const sizeId = Number(pill.getAttribute('data-size-id'));
        designSwatches.forEach((swatch) => {
          if (Number(swatch.getAttribute('data-size-id')) === sizeId) {
            const sku = swatch.getAttribute('data-sku');
            if (sku) preloadVariant(sku);
          }
        });
      });
    });

    // Background idle preload of primary thumbnails across all variants
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(() => {
        variantsMap.forEach((v) => {
          if (v.gallery[0]) preloadImage(v.gallery[0]);
        });
      }, { timeout: 2000 });
    } else {
      setTimeout(() => {
        variantsMap.forEach((v) => {
          if (v.gallery[0]) preloadImage(v.gallery[0]);
        });
      }, 500);
    }

    function renderGalleryForVariant(sku: string) {
      const variant = variantsMap.get(sku);
      if (!variant || !mediaContainer) return;

      // Reset any active drag state
      isPointerDown = false;
      isHorizontalDrag = false;
      dragDeltaX = 0;
      mediaContainer.classList.remove('is-dragging');

      // Find or create the canonical gallery container
      let gal = document.getElementById('active-gallery') as HTMLElement | null;
      if (!gal) {
        gal = mediaContainer.querySelector<HTMLElement>('.variant-gallery');
      }
      if (!gal) {
        gal = document.createElement('div');
        gal.className = 'variant-gallery';
        if (controlsContainer && controlsContainer.parentElement === mediaContainer) {
          mediaContainer.insertBefore(gal, controlsContainer);
        } else {
          mediaContainer.appendChild(gal);
        }
      }
      gal.id = 'active-gallery';
      gal.classList.remove('is-incoming');
      gal.style.opacity = '1';
      gal.style.transition = 'transform 320ms cubic-bezier(0.25, 1, 0.5, 1)';
      gal.style.transform = 'translateX(0%)';
      gal.setAttribute('data-sku', sku);

      // Clean up any extraneous or orphaned gallery elements
      const allGalleries = mediaContainer.querySelectorAll<HTMLElement>('.variant-gallery');
      allGalleries.forEach((g) => {
        if (g !== gal) g.remove();
      });

      activeGalleryContainer = gal;
      currentSlideIdx = 0;

      // Build slide elements synchronously
      let html = '';
      variant.gallery.forEach((url, idx) => {
        html += `<div class="gallery-slide ${idx === 0 ? 'is-active' : ''}" data-slide-idx="${idx}">` +
          `<img src="${url}" alt="${sku} photo ${idx + 1}" ${idx === 0 ? 'loading="eager" fetchpriority="high"' : 'loading="lazy"'} decoding="async" />` +
          `</div>`;
      });
      gal.innerHTML = html;

      // Update dots and controls visibility
      if (controlsContainer && dotsContainer) {
        if (variant.gallery.length > 1) {
          mediaContainer.classList.add('has-multiple-slides');
          controlsContainer.style.display = 'flex';
          let dotsHtml = '';
          for (let i = 0; i < variant.gallery.length; i++) {
            dotsHtml += `<button type="button" class="dot ${i === 0 ? 'is-active' : ''}" data-dot-idx="${i}" aria-label="Go to slide ${i + 1}"></button>`;
          }
          dotsContainer.innerHTML = dotsHtml;
          rebindDots();
        } else {
          mediaContainer.classList.remove('has-multiple-slides');
          controlsContainer.style.display = 'none';
          dotsContainer.innerHTML = '';
        }
      }

      showSlide(0, false);
    }

    // Attach navigation button handlers
    if (prevBtn) {
      prevBtn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (currentSlideIdx > 0) {
          showSlide(currentSlideIdx - 1, true);
        }
      };
    }

    if (nextBtn) {
      nextBtn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slides = activeGalleryContainer ? activeGalleryContainer.querySelectorAll('.gallery-slide') : [];
        if (currentSlideIdx < slides.length - 1) {
          showSlide(currentSlideIdx + 1, true);
        }
      };
    }

    // Keyboard Arrow navigation
    window.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      const slides = activeGalleryContainer ? activeGalleryContainer.querySelectorAll('.gallery-slide') : [];
      if (e.key === 'ArrowLeft' && currentSlideIdx > 0) {
        showSlide(currentSlideIdx - 1, true);
      } else if (e.key === 'ArrowRight' && currentSlideIdx < slides.length - 1) {
        showSlide(currentSlideIdx + 1, true);
      }
    });

    // Unified Drag & Slide handling for continuous carousel track
    let isPointerDown = false;
    let pointerStartX = 0;
    let pointerStartY = 0;
    let dragDeltaX = 0;
    let isHorizontalDrag = false;
    let dragStartTime = 0;

    function hasMultipleSlides(): boolean {
      const slides = activeGalleryContainer ? activeGalleryContainer.querySelectorAll('.gallery-slide') : [];
      return slides.length > 1;
    }

    if (mediaContainer) {
      mediaContainer.classList.toggle('has-multiple-slides', hasMultipleSlides());

      mediaContainer.addEventListener('pointerdown', (e: PointerEvent) => {
        if (!hasMultipleSlides() || !activeGalleryContainer) return;
        if ((e.target as HTMLElement)?.closest('#gallery-controls, .product-hero__badge')) return;

        isPointerDown = true;
        isHorizontalDrag = false;
        pointerStartX = e.clientX;
        pointerStartY = e.clientY;
        dragDeltaX = 0;
        dragStartTime = Date.now();

        try {
          mediaContainer.setPointerCapture(e.pointerId);
        } catch (_) {}
      });

      mediaContainer.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isPointerDown || !hasMultipleSlides() || !activeGalleryContainer) return;

        const deltaX = e.clientX - pointerStartX;
        const deltaY = e.clientY - pointerStartY;

        if (!isHorizontalDrag) {
          if (Math.abs(deltaY) > 8 && Math.abs(deltaY) > Math.abs(deltaX)) {
            // User is scrolling the page vertically -> cancel drag
            isPointerDown = false;
            mediaContainer.classList.remove('is-dragging');
            try {
              if (mediaContainer.hasPointerCapture(e.pointerId)) {
                mediaContainer.releasePointerCapture(e.pointerId);
              }
            } catch (_) {}
            return;
          }
          if (Math.abs(deltaX) > 6) {
            isHorizontalDrag = true;
            mediaContainer.classList.add('is-dragging');
          }
        }

        if (isHorizontalDrag) {
          e.preventDefault();
          dragDeltaX = deltaX;
          const containerWidth = mediaContainer.clientWidth || 1;
          const slides = activeGalleryContainer.querySelectorAll('.gallery-slide');
          const count = slides.length;

          // Boundary constraints:
          // The first image cannot be dragged to the right (deltaX > 0),
          // The last image cannot be dragged to the left (deltaX < 0)
          let effectiveDeltaX = deltaX;
          if (currentSlideIdx === 0 && deltaX > 0) {
            effectiveDeltaX = deltaX * 0.15; // Rubber-band resistance on right-drag of first slide
          } else if (currentSlideIdx === count - 1 && deltaX < 0) {
            effectiveDeltaX = deltaX * 0.15; // Rubber-band resistance on left-drag of last slide
          }

          // Move the entire track in real-time so adjacent images slide together
          activeGalleryContainer.style.transition = 'none';
          const baseOffsetPx = -currentSlideIdx * containerWidth;
          activeGalleryContainer.style.transform = `translateX(${baseOffsetPx + effectiveDeltaX}px)`;
        }
      });

      const finishDrag = (e: PointerEvent) => {
        if (!isPointerDown) return;
        isPointerDown = false;
        mediaContainer.classList.remove('is-dragging');

        try {
          if (mediaContainer.hasPointerCapture(e.pointerId)) {
            mediaContainer.releasePointerCapture(e.pointerId);
          }
        } catch (_) {}

        if (isHorizontalDrag && activeGalleryContainer) {
          const slides = activeGalleryContainer.querySelectorAll('.gallery-slide');
          const count = slides.length;
          const duration = Date.now() - dragStartTime;
          const velocity = Math.abs(dragDeltaX) / Math.max(duration, 1);

          if (dragDeltaX < -45 || (dragDeltaX < -20 && velocity > 0.3)) {
            // Dragged left -> advance to next if available, else bounce back
            if (currentSlideIdx < count - 1) {
              showSlide(currentSlideIdx + 1, true);
            } else {
              showSlide(currentSlideIdx, true);
            }
          } else if (dragDeltaX > 45 || (dragDeltaX > 20 && velocity > 0.3)) {
            // Dragged right -> advance to prev if available, else bounce back
            if (currentSlideIdx > 0) {
              showSlide(currentSlideIdx - 1, true);
            } else {
              showSlide(currentSlideIdx, true);
            }
          } else {
            // Did not cross threshold -> snap back to current
            showSlide(currentSlideIdx, true);
          }
        }

        isHorizontalDrag = false;
        dragDeltaX = 0;
      };

      mediaContainer.addEventListener('pointerup', finishDrag);
      mediaContainer.addEventListener('pointercancel', finishDrag);
    }

    window.addEventListener('resize', () => {
      if (activeGalleryContainer) {
        showSlide(currentSlideIdx, false);
      }
    });

    // Initial setup
    showSlide(0, false);
    rebindDots();

    function updateRetailLinks(sku: string) {
      if (!root) return;
      const v = variantsMap.get(sku);
      const rLinks = v?.retail_links || {};
      let hasAnyRetail = false;

      const badges = root.querySelectorAll<HTMLAnchorElement>('[data-retailer-id]');
      badges.forEach((badge) => {
        const rid = badge.getAttribute('data-retailer-id');
        const url = rid ? rLinks[rid] : undefined;
        if (url) {
          badge.href = url;
          badge.style.display = 'inline-flex';
          hasAnyRetail = true;
        } else {
          badge.style.display = 'none';
        }
      });

      const retailGrid = document.getElementById('retail-links-grid');
      const retailEmpty = document.getElementById('retail-empty-note');
      if (retailGrid) retailGrid.style.display = hasAnyRetail ? '' : 'none';
      if (retailEmpty) retailEmpty.style.display = hasAnyRetail ? 'none' : '';
    }

    function activateSku(sku: string) {
      if (sku === activeSku && activeGalleryContainer?.getAttribute('data-sku') === sku) return;
      activeSku = sku;
      
      // Update design swatches
      designSwatches.forEach((swatch) => {
        const isSelected = swatch.getAttribute('data-sku') === sku;
        swatch.classList.toggle('is-selected', isSelected);
        swatch.setAttribute('aria-checked', isSelected ? 'true' : 'false');
        swatch.setAttribute('tabindex', isSelected ? '0' : '-1');
      });

      // Dynamically load gallery images for selected SKU
      renderGalleryForVariant(sku);

      // Dynamically update retail links for selected SKU
      updateRetailLinks(sku);

      // Update SKU display
      if (skuDisplay && sku) {
        skuDisplay.textContent = `SKU ${sku}`;
      }

      // Sync URL without reload
      if (window.history.replaceState && sku) {
        const url = new URL(window.location.href);
        url.searchParams.set('sku', sku);
        window.history.replaceState({}, '', url.toString());
      }
    }

    function selectSize(sizeId: number) {
      activeSizeId = sizeId;

      // Update size pills
      sizePills.forEach((pill) => {
        const isSelected = Number(pill.getAttribute('data-size-id')) === sizeId;
        pill.classList.toggle('is-selected', isSelected);
        pill.setAttribute('aria-checked', isSelected ? 'true' : 'false');
        pill.setAttribute('tabindex', isSelected ? '0' : '-1');
      });

      // Filter design swatches
      let firstVisibleSku: string | null = null;
      let currentSkuStillVisible = false;

      designSwatches.forEach((swatch) => {
        const matchesSize = Number(swatch.getAttribute('data-size-id')) === sizeId;
        swatch.classList.toggle('is-hidden', !matchesSize);

        if (matchesSize) {
          const sku = swatch.getAttribute('data-sku');
          if (!firstVisibleSku && sku) firstVisibleSku = sku;
          if (sku === activeSku) currentSkuStillVisible = true;
        }
      });

      // If current selected design is not in this size, switch to first visible
      if (!currentSkuStillVisible && firstVisibleSku) {
        activateSku(firstVisibleSku);
      }
    }

    // Size pill click handlers
    sizePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const sizeId = Number(pill.getAttribute('data-size-id'));
        if (sizeId) selectSize(sizeId);
      });
    });

    // Size pill keyboard arrow navigation (WAI-ARIA Radiogroup)
    const sizePillGroup = root.querySelector('.size-pill-group');
    if (sizePillGroup) {
      sizePillGroup.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        const availablePills = Array.from(sizePills).filter((p) => !p.disabled);
        const currentIdx = availablePills.findIndex((p) => p.classList.contains('is-selected'));
        if (currentIdx === -1) return;

        let nextIdx = -1;
        if (keyEvent.key === 'ArrowRight' || keyEvent.key === 'ArrowDown') {
          nextIdx = (currentIdx + 1) % availablePills.length;
        } else if (keyEvent.key === 'ArrowLeft' || keyEvent.key === 'ArrowUp') {
          nextIdx = (currentIdx - 1 + availablePills.length) % availablePills.length;
        }

        if (nextIdx !== -1) {
          keyEvent.preventDefault();
          const target = availablePills[nextIdx];
          target.focus();
          const sizeId = Number(target.getAttribute('data-size-id'));
          if (sizeId) selectSize(sizeId);
        }
      });
    }

    // Design swatch click handlers
    designSwatches.forEach((swatch) => {
      swatch.addEventListener('click', () => {
        const sku = swatch.getAttribute('data-sku');
        if (sku) activateSku(sku);
      });
    });

    // Design swatch keyboard arrow navigation (WAI-ARIA Radiogroup)
    const swatchGrid = root.querySelector('.design-swatch-grid');
    if (swatchGrid) {
      swatchGrid.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        const visibleSwatches = Array.from(designSwatches).filter((s) => !s.classList.contains('is-hidden'));
        const currentIdx = visibleSwatches.findIndex((s) => s.classList.contains('is-selected'));
        if (currentIdx === -1) return;

        let nextIdx = -1;
        if (keyEvent.key === 'ArrowRight' || keyEvent.key === 'ArrowDown') {
          nextIdx = (currentIdx + 1) % visibleSwatches.length;
        } else if (keyEvent.key === 'ArrowLeft' || keyEvent.key === 'ArrowUp') {
          nextIdx = (currentIdx - 1 + visibleSwatches.length) % visibleSwatches.length;
        }

        if (nextIdx !== -1) {
          keyEvent.preventDefault();
          const target = visibleSwatches[nextIdx];
          target.focus();
          const sku = target.getAttribute('data-sku');
          if (sku) activateSku(sku);
        }
      });
    }

    // Synchronize bottom-docking / top-docking sticky positions for desktop dual-column layout
    function updateStickyOffsets() {
      const mediaCol = root.querySelector<HTMLElement>('.product-hero__media-col');
      const bodyCol = root.querySelector<HTMLElement>('.product-hero__body');
      if (!mediaCol || !bodyCol) return;

      if (window.innerWidth < 900 || window.innerHeight < 500) {
        mediaCol.style.top = '';
        bodyCol.style.top = '';
        return;
      }

      const vh = window.innerHeight;
      const headerOffset = 86; // 70px sticky header + 16px breathing margin
      const bottomGap = 24;
      const heroRect = root.getBoundingClientRect();
      const naturalTop = Math.max(headerOffset, Math.round(heroRect.top + window.scrollY));

      [mediaCol, bodyCol].forEach((col) => {
        const h = col.offsetHeight;
        // 1. If column fits completely in viewport at its natural initial position (e.g. 60x90 size):
        //    Pin directly at naturalTop so it does NOT scroll at all from pixel 0 until other column catches up!
        if (h + naturalTop + bottomGap <= vh) {
          col.style.top = `${naturalTop}px`;
        } else if (h + headerOffset + bottomGap <= vh) {
          // 2. If it fits within the viewport when tucked below header:
          //    Pin at headerOffset so it stays fully visible
          col.style.top = `${headerOffset}px`;
        } else {
          // 3. If column is taller than viewport (e.g. 45x60 size):
          //    Scroll until its bottom edge docks 24px above viewport bottom so all contents are 100% visible
          col.style.top = `${vh - h - bottomGap}px`;
        }
      });
    }

    // Call updateStickyOffsets whenever size changes
    const originalSelectSize = selectSize;
    selectSize = function(sizeId: number) {
      originalSelectSize(sizeId);
      requestAnimationFrame(updateStickyOffsets);
    };

    // Deep linking on load: check ?sku= in URL
    const params = new URLSearchParams(window.location.search);
    const skuParam = params.get('sku');
    if (skuParam && skuParam !== activeSku) {
      const targetSwatch = root.querySelector<HTMLButtonElement>(`.design-swatch[data-sku="${skuParam}"]`);
      if (targetSwatch) {
        const sizeId = Number(targetSwatch.getAttribute('data-size-id'));
        if (sizeId && sizeId !== activeSizeId) selectSize(sizeId);
        activateSku(skuParam);
      }
    }

    window.addEventListener('resize', updateStickyOffsets);
    const ro = new ResizeObserver(() => updateStickyOffsets());
    const mediaColEl = root.querySelector<HTMLElement>('.product-hero__media-col');
    const bodyColEl = root.querySelector<HTMLElement>('.product-hero__body');
    if (mediaColEl) ro.observe(mediaColEl);
    if (bodyColEl) ro.observe(bodyColEl);
    requestAnimationFrame(updateStickyOffsets);
  }

  document.addEventListener('astro:page-load', initVariantPicker);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVariantPicker);
  } else {
    initVariantPicker();
  }
</script>

