---
import BaseLayout from '../layouts/BaseLayout.astro';
import Trans from '../components/Trans.astro';
import ContactChannels from '../components/ContactChannels.astro';
---
<BaseLayout
  title="Wholesale pet products from Türkiye"
  titleTr="Toptan evcil hayvan ürünleri"
  description="Buy washable litter mats and scratching pads direct from the manufacturer. Factory in Ankara, duty-free shipping into the EU."
  descriptionTr="Yıkanabilir kedi paspaslarını ve tırmalama pedlerini doğrudan üreticiden alın. Fabrikamız Ankara'da."
>
  <section class="section">
    <div class="container container--narrow">
      <p class="eyebrow"><Trans en="Wholesale" tr="Toptan Satış" /></p>
      <h1><Trans en="Factory direct supply." tr="Doğrudan üreticiden toptan tedarik." /></h1>
      <p class="lede">
        <Trans
          en="We manufacture pet mats and pads at our production facility. Textile printing, precision die-cutting, and edge binding all run in-house."
          tr="Kedi ve köpekler için geliştirdiğimiz tekstil ürünlerini kendi üretim tesisimizde üretiyoruz. Tekstil baskısı, hassas kalıp kesim ve biye dikişini tek çatı altında gerçekleştiriyoruz."
        />
      </p>

      <h2><Trans en="What we offer" tr="Neler Sunuyoruz?" /></h2>
      <ul>
        <li><Trans en="Monthly capacity of up to 20,000 units on our standard line." tr="Standart ebatlarda aylık 20.000 adede varan üretim kapasitesi." /></li>
        <li><Trans en="Hexagonal honeycomb mesh and spunbond PP bottom pocket with integrated hanging handle." tr="Altıgen petek dokulu üst katman, kumaş tela alt toplama cebi ve entegre askı/tutamaç detayı." /></li>
        <li><Trans en="Custom digital surface prints, tailored dimensions, and retail packaging for volume runs." tr="Toptan alımlarda isteğe özel dijital desen baskısı, farklı ölçü seçenekleri ve özel ambalajlama." /></li>
        <li><Trans en="Flexible minimum order quantities with sample runs and trial batches available." tr="Numune ve deneme siparişlerine uygun esnek adetler." /></li>
        <li><Trans en="Direct shipment from our factory to your warehouse or distribution hub." tr="Fabrikamızdan doğrudan adresinize veya deponuza sevkiyat." /></li>
      </ul>

      <h2><Trans en="What we can customize" tr="Özelleştirme İmkanları" /></h2>
      <ul>
        <li><Trans en="Patterns & artwork: Production using your supplied surface designs." tr="Desen ve Görsel: Kendi hazırladığınız veya talep ettiğiniz desenlerle baskı." /></li>
        <li><Trans en="Dimensions: Custom width and length cuts to match your requirements." tr="Ölçü: İhtiyacınıza uygun özel en ve boy ebatlama." /></li>
        <li><Trans en="Packaging: Custom outer cartons, retail bands, and display boxes." tr="Ambalaj: Özel ürün bandı, etiket ve sergileme kutusu seçenekleri." /></li>
      </ul>

      <h2><Trans en="What we need for a quote" tr="Fiyat Teklifi İçin" /></h2>
      <ul>
        <li><Trans en="Company name and delivery location." tr="Firma adı ve teslimat adresi." /></li>
        <li><Trans en="Selected catalog products or custom specifications (dimensions and prints)." tr="İlgilendiğiniz modeller, talep edilen ölçü ve adet bilgisi." /></li>
        <li><Trans en="Estimated quantity and requested delivery schedule." tr="Varsa özel desen, baskı veya ambalaj talepleriniz." /></li>
      </ul>

      <h2><Trans en="Get in touch" tr="Teklif ve İletişim" /></h2>
      <p>
        <Trans
          en="Reach out through any channel below to discuss pricing, lead times, or custom specs."
          tr="Toptan fiyat listesi, numune talepleri ve üretim detayları için aşağıdaki kanallardan bize ulaşabilirsiniz."
        />
      </p>

      <ContactChannels variant="wholesale" />
    </div>
  </section>
</BaseLayout>

<style>
  .lede { font-size: 1.15rem; color: var(--color-ink-soft); max-width: 60ch; }
  h2 { margin-top: var(--space-6); }
</style>
