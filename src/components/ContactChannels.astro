---
import Trans from './Trans.astro';

interface Props {
  variant?: 'wholesale' | 'general';
}

const { variant = 'general' } = Astro.props;

// Default contact coordinates
const whatsapp = 'https://wa.me/905423494229';
const emailGeneral = 'info@canicopet.com';
const emailWholesale = 'info@canicopet.com';
const email = variant === 'wholesale' ? emailWholesale : emailGeneral;
const instagram = 'https://instagram.com/canicopet';
const linkedin = 'https://linkedin.com/company/canicopet';
---
<div class="channels">
  <a class="channel" href={whatsapp} target="_blank" rel="noopener noreferrer">
    <div class="channel__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
        <path d="M20.5 3.5A11 11 0 0 0 2.7 17.1L1 23l6-1.6a11 11 0 0 0 5.3 1.3h.1a11 11 0 0 0 8.1-19.2ZM12.3 20.6h-.1a9 9 0 0 1-4.7-1.3l-.3-.2-3.6.9 1-3.5-.2-.4a9.1 9.1 0 1 1 7.9 4.5Zm5-6.7c-.3-.1-1.6-.8-1.9-.9s-.4-.1-.6.2c-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.8-.7-1.4-1.7-1.6-2s0-.3.1-.4l.4-.4c.1-.1.2-.3.3-.5s.1-.3 0-.5c-.1-.1-.6-1.5-.8-2s-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.3s-1 1-1 2.4c0 1.4 1 2.7 1.2 2.9.1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.6-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3Z"/>
      </svg>
    </div>
    <div class="channel__body">
      <p class="channel__label">WhatsApp</p>
      <p class="channel__value">
        <Trans en="Best for TR wholesale" tr="Hızlı iletişim & WhatsApp" />
      </p>
    </div>
  </a>

  <a class="channel" href={`mailto:${email}`}>
    <div class="channel__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="3" y="5" width="18" height="14" rx="2"/>
        <path d="m3 7 9 6 9-6"/>
      </svg>
    </div>
    <div class="channel__body">
      <p class="channel__label">
        <Trans en="Email" tr="E-posta" />
      </p>
      <p class="channel__value">{email}</p>
    </div>
  </a>

  <a class="channel" href={instagram} target="_blank" rel="noopener noreferrer">
    <div class="channel__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="3" y="3" width="18" height="18" rx="5"/>
        <circle cx="12" cy="12" r="4"/>
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
      </svg>
    </div>
    <div class="channel__body">
      <p class="channel__label">Instagram</p>
      <p class="channel__value">@canicopet</p>
    </div>
  </a>

  <a class="channel" href={linkedin} target="_blank" rel="noopener noreferrer">
    <div class="channel__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
        <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1c.5-1 1.9-2 3.9-2 4.2 0 5 2.7 5 6.2V21h-4v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-4V9Z"/>
      </svg>
    </div>
    <div class="channel__body">
      <p class="channel__label">LinkedIn</p>
      <p class="channel__value">
        <Trans en="For EU wholesalers" tr="Kurumsal ve ihracat iletişimi" />
      </p>
    </div>
  </a>

  <!-- Inactive contact form channel: preserved in markup, hidden until form endpoint connects -->
  <a class="channel channel--form" href="#contact-form" style="display: none;" aria-hidden="true">
    <div class="channel__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M4 4h16v16H4z"/>
        <path d="M8 9h8M8 13h8M8 17h5"/>
      </svg>
    </div>
    <div class="channel__body">
      <p class="channel__label">
        <Trans en="Form" tr="İletişim Formu" />
      </p>
      <p class="channel__value">
        <Trans en="Use the form below" tr="Mesaj bırakmak için tıklayın" />
      </p>
    </div>
  </a>
</div>

<!-- Inactive contact form: preserved in markup, hidden and disabled until form endpoint connects -->
<section id="contact-form" class="contact-form" style="display: none;" aria-hidden="true">
  <h3>
    <Trans en="Send us a message" tr="Bize mesaj gönderin" />
  </h3>
  <p class="contact-form__note">
    <span class="placeholder-note">
      <Trans en="Direct message" tr="Doğrudan mesaj" />
    </span>
    <Trans
      en="Fill in the details below or email us directly at info@canicopet.com."
      tr="Aşağıdaki formu doldurabilir veya info@canicopet.com adresine doğrudan e-posta gönderebilirsiniz."
    />
  </p>
  <form class="cform" id="main-contact-form" method="post" action="#">
    <fieldset disabled style="border: 0; padding: 0; margin: 0; display: grid; gap: var(--space-3);">
      <div class="cform__row">
        <label for="cform-name"><span><Trans en="Your name" tr="Adınız Soyadınız" /></span></label>
        <input type="text" id="cform-name" name="name" required autocomplete="name" />
      </div>
      <div class="cform__row">
        <label for="cform-company"><span><Trans en="Company (optional)" tr="Firma / Şirket Adı (İsteğe bağlı)" /></span></label>
        <input type="text" id="cform-company" name="company" autocomplete="organization" />
      </div>
      <div class="cform__row">
        <label for="cform-email"><span><Trans en="Email" tr="E-posta Adresiniz" /></span></label>
        <input type="email" id="cform-email" name="email" required autocomplete="email" />
      </div>
      <div class="cform__row" lang="en">
        <label for="cform-topic"><span>What can we help with?</span></label>
        <select id="cform-topic" name="topic">
          <option value="wholesale">Wholesale inquiry</option>
          <option value="sample">Sample request</option>
          <option value="custom">Custom production / Sizing</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="cform__row" lang="tr">
        <label for="cform-topic-tr"><span>Konu</span></label>
        <select id="cform-topic-tr" name="topic_tr">
          <option value="wholesale">Toptan Satış ve Fiyat Listesi</option>
          <option value="sample">Numune Talebi</option>
          <option value="custom">Özel Üretim / Farklı Ölçü</option>
          <option value="other">Diğer Sorular</option>
        </select>
      </div>
      <div class="cform__row">
        <label for="cform-message"><span><Trans en="Message" tr="Mesajınız" /></span></label>
        <textarea id="cform-message" name="message" rows="5" required></textarea>
      </div>
      <button type="submit" class="btn btn--primary">
        <Trans en="Send" tr="Mesaj Gönder" />
      </button>
      <div id="cform-status" class="cform-status" role="status" aria-live="polite"></div>
    </fieldset>
  </form>
</section>

<script>
  function initContactForm() {
    const form = document.getElementById('main-contact-form') as HTMLFormElement | null;
    if (!form || form.closest('[aria-hidden="true"]')) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const statusEl = document.getElementById('cform-status');
      const isTr = document.documentElement.classList.contains('lang-tr');
      const msg = isTr
        ? 'Mesajınız için teşekkür ederiz! En kısa sürede sizinle iletişime geçeceğiz. Dilerseniz bize info@canicopet.com adresinden de doğrudan ulaşabilirsiniz.'
        : 'Thank you for your message! We will get back to you shortly. You can also reach us directly at info@canicopet.com.';
      if (statusEl) {
        statusEl.textContent = msg;
        statusEl.className = 'cform-status cform-status--success';
      }
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
</script>

<style>
  .channels {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-block: var(--space-5);
    max-width: 640px;
  }
  @media (min-width: 640px) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    background: white;
    transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    min-width: 0;
  }
  .channel:hover {
    border-color: var(--color-coral);
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
    color: inherit;
  }
  .channel__icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--color-coral) 12%, transparent);
    border-radius: 12px;
    color: var(--color-coral);
  }
  .channel__body { min-width: 0; }
  .channel__label {
    margin: 0;
    font-weight: 700;
    font-size: 14px;
    color: var(--color-ink);
  }
  .channel__value {
    margin: 2px 0 0 0;
    color: var(--color-muted);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .contact-form {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--color-bg-soft);
    border-radius: var(--radius-lg);
    border: 1.5px solid var(--color-line);
    max-width: 640px;
  }
  .contact-form__note {
    color: var(--color-muted);
    font-size: 13px;
    margin-bottom: var(--space-4);
  }
  .cform {
    display: grid;
    gap: var(--space-3);
  }
  .cform__row {
    display: grid;
    gap: 4px;
  }
  .cform__row > span {
    font-size: 13px;
    color: var(--color-ink-soft);
    font-weight: 500;
  }
  .cform input,
  .cform select,
  .cform textarea {
    font-family: var(--font-sans);
    font-size: 15px;
    padding: 10px 12px;
    border-radius: var(--radius);
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-ink);
    width: 100%;
  }
  .cform textarea { resize: vertical; }
  .cform button {
    justify-self: start;
    margin-top: var(--space-2);
  }
  .cform-status {
    margin-top: var(--space-3);
    font-size: 14px;
    line-height: 1.5;
  }
  .cform-status--success {
    color: var(--color-ink);
    background: var(--color-bg);
    padding: var(--space-3);
    border-radius: var(--radius);
    border-left: 3px solid var(--color-coral);
  }
</style>
