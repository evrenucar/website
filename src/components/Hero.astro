---
interface Props {
  eyebrow?: string;
  eyebrowTr?: string;
  title: string;
  titleTr?: string;
  lede?: string;
  ledeTr?: string;
  ctaHref?: string;
  ctaLabel?: string;
  ctaLabelTr?: string;
  ctaSecondaryHref?: string;
  ctaSecondaryLabel?: string;
  ctaSecondaryLabelTr?: string;
}

const {
  eyebrow,
  eyebrowTr,
  title,
  titleTr,
  lede,
  ledeTr,
  ctaHref,
  ctaLabel,
  ctaLabelTr,
  ctaSecondaryHref,
  ctaSecondaryLabel,
  ctaSecondaryLabelTr,
} = Astro.props;
---
<section class="hero section">
  <div class="container container--narrow">
    {eyebrow && (
      <p class="eyebrow">
        <span lang="en">{eyebrow}</span>{eyebrowTr && <span lang="tr">{eyebrowTr}</span>}
      </p>
    )}
    <h1>
      <span lang="en">{title}</span>{titleTr && <span lang="tr">{titleTr}</span>}
    </h1>
    {lede && (
      <p class="hero__lede">
        <span lang="en">{lede}</span>{ledeTr && <span lang="tr">{ledeTr}</span>}
      </p>
    )}
    {(ctaHref || ctaSecondaryHref) && (
      <div class="hero__ctas">
        {ctaHref && ctaLabel && (
          <a class="btn btn--primary" href={ctaHref}>
            <span lang="en">{ctaLabel}</span>{ctaLabelTr && <span lang="tr">{ctaLabelTr}</span>}
          </a>
        )}
        {ctaSecondaryHref && ctaSecondaryLabel && (
          <a class="btn btn--ghost" href={ctaSecondaryHref}>
            <span lang="en">{ctaSecondaryLabel}</span>{ctaSecondaryLabelTr && <span lang="tr">{ctaSecondaryLabelTr}</span>}
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero__lede {
    font-size: 1.2rem;
    color: var(--color-ink-soft);
    max-width: 60ch;
  }
  .hero__ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
</style>
