---
import Trans from './Trans.astro';

const features = [
  {
    color: 'var(--color-coral)',
    icon: '🧵',
    title_en: 'In-house textile factory',
    title_tr: 'Kendi tekstil fabrikamız',
    body_en: 'Print, cut, sew, and finish at Aktunc Tekstil in Ankara.',
    body_tr: 'Ankara\'daki Aktunc Tekstil\'de baskı, kesim, dikim ve bitirme.',
  },
  {
    color: 'var(--color-lavender)',
    icon: '🐈',
    title_en: 'Cat products, tested by cats',
    title_tr: 'Kediler tarafından test edilen ürünler',
    body_en: 'Litter mats and scratching pads sized for real households.',
    body_tr: 'Gerçek hanelere göre boyutlandırılmış paspas ve tırmalama pedleri.',
  },
  {
    color: 'var(--color-sunshine)',
    icon: '🐕',
    title_en: 'Dog line in production',
    title_tr: 'Köpek serisi üretimde',
    body_en: 'Feeding mats, water mats, and floor protection mats next.',
    body_tr: 'Mama paspası, su paspası ve zemin koruma sırada.',
  },
  {
    color: 'var(--color-teal)',
    icon: '✂️',
    title_en: 'Custom sizes and prints',
    title_tr: 'Özel boyut ve baskı',
    body_en: 'Adjust dimensions, patterns, and colors per order.',
    body_tr: 'Boyut, desen ve renk sipariş bazında ayarlanır.',
  },
  {
    color: 'var(--color-pink)',
    icon: '📦',
    title_en: 'Private-label ready',
    title_tr: 'Özel marka hazır',
    body_en: 'Your logo on the label, packaging, and hangtag.',
    body_tr: 'Etiket, ambalaj ve hangtag üzerinde logonuz.',
  },
  {
    color: 'var(--color-cobalt)',
    icon: '🚚',
    title_en: 'Direct shipping from Ankara',
    title_tr: 'Ankara\'dan doğrudan sevkiyat',
    body_en: 'To your warehouse, without a middleman.',
    body_tr: 'Aracısız, doğrudan deponuza.',
  },
];
const doubled = [...features, ...features];
---
<div class="vcarousel" aria-label="Reasons wholesalers work with Canico">
  <div class="vcarousel__track">
    {doubled.map((f) => (
      <div class="vfeature" style={`--f-color:${f.color}`}>
        <div class="vfeature__icon" aria-hidden="true">{f.icon}</div>
        <div>
          <h4 class="vfeature__title">
            <Trans en={f.title_en} tr={f.title_tr} />
          </h4>
          <p class="vfeature__body">
            <Trans en={f.body_en} tr={f.body_tr} />
          </p>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .vfeature {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: white;
    border: 1.5px solid var(--color-line);
    border-left: 4px solid var(--f-color, var(--color-coral));
    border-radius: var(--radius);
    padding: 14px 16px;
  }
  .vfeature__icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--f-color) 15%, transparent);
    border-radius: 999px;
    font-size: 20px;
    flex-shrink: 0;
  }
  .vfeature__title {
    margin: 0 0 4px 0;
    font-size: 15px;
    font-weight: 700;
  }
  .vfeature__body {
    margin: 0;
    font-size: 13px;
    color: var(--color-ink-soft);
    line-height: 1.4;
  }
</style>
