---
import Trans from './Trans.astro';

// Duplicate the item list so the CSS translateX(-50%) creates a seamless loop.
const items = [
  { en: 'Made in Ankara, Turkiye', tr: 'Türkiye, Ankara üretimi' },
  { en: 'Textile mats for cats and dogs', tr: 'Kedi ve köpekler için tekstil paspaslar' },
  { en: 'Wholesale samples on request', tr: 'Talep üzerine toptan numune' },
  { en: 'Custom prints available', tr: 'Özel baskı seçenekleri' },
  { en: 'Private-label from your first order', tr: 'İlk siparişinizden itibaren özel marka' },
  { en: 'EU shipping from Ankara', tr: 'Ankara\'dan AB sevkiyatı' },
];
const doubled = [...items, ...items];
---
<div class="marquee" aria-label="Canico Pets highlights">
  <div class="marquee__track">
    {doubled.map((it) => (
      <div class="marquee__item">
        <Trans en={it.en} tr={it.tr} />
        <span class="marquee__dot" aria-hidden="true"></span>
      </div>
    ))}
  </div>
</div>
