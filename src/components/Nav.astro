---
import Trans from './Trans.astro';
import { base } from '../lib/paths';
// Strip the base prefix so isActive() compares clean route paths regardless
// of whether the site is served from the domain root or a Pages subpath.
const path = Astro.url.pathname.replace(new RegExp('^' + base), '') || '/';
const isActive = (p: string) => path === p || path.startsWith(p + '/');
---
<header class="site-nav">
  <div class="container site-nav__inner">
    <a href={`${base}/`} class="site-nav__brand" aria-label="Canico Pets home">
      <img src={`${base}/caniko_logo_dark_color1080.png`} alt="Canico Pets" width="200" height="50" fetchpriority="high" decoding="sync" />
    </a>

    <nav id="site-nav-menu" class="site-nav__nav" data-open="false" aria-label="Primary">
      <ul class="site-nav__links">
        <li><a href={`${base}/products`} class:list={[{ 'is-active': isActive('/products') }]}>
          <Trans en="Products" tr="Ürünler" />
        </a></li>
        <li><a href={`${base}/wholesale`} class:list={[{ 'is-active': isActive('/wholesale') }]}>
          <Trans en="Wholesale" tr="Toptan" />
        </a></li>
        <li><a href={`${base}/about`} class:list={[{ 'is-active': isActive('/about') }]}>
          <Trans en="About" tr="Hakkımızda" />
        </a></li>
        <li><a href={`${base}/contact`} class:list={[{ 'is-active': isActive('/contact') }]}>
          <Trans en="Contact" tr="İletişim" />
        </a></li>
        <li class="site-nav__mobile-lang">
          <div class="lang-toggle" role="group" aria-label="Language">
            <button type="button" data-lang-switch="en" aria-pressed="true" aria-label="Switch to English">EN</button>
            <button type="button" data-lang-switch="tr" aria-pressed="false" aria-label="Türkçe'ye geç">TR</button>
          </div>
        </li>
      </ul>
    </nav>

    <div class="lang-toggle site-nav__lang" role="group" aria-label="Language">
      <button type="button" data-lang-switch="en" aria-pressed="true" aria-label="Switch to English">EN</button>
      <button type="button" data-lang-switch="tr" aria-pressed="false" aria-label="Türkçe'ye geç">TR</button>
    </div>

    <button
      class="site-nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-menu"
      aria-label="Toggle menu"
    >
      <span class="site-nav__toggle-bar" aria-hidden="true"></span>
      <span class="site-nav__toggle-bar" aria-hidden="true"></span>
      <span class="site-nav__toggle-bar" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('.site-nav__toggle');
    var panel = document.getElementById('site-nav-menu');
    if (!btn || !panel) return;

    function setOpen(open) {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.dataset.open = open ? 'true' : 'false';
      document.body.style.overflow = open ? 'hidden' : '';
    }

    btn.addEventListener('click', function () {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>

<style>
  .site-nav {
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-line);
  }

  .site-nav__inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
    padding-block: 12px;
    min-height: 70px;
    flex-wrap: nowrap;
  }

  .site-nav__brand {
    flex-shrink: 0;
    line-height: 0;
    margin-right: auto;
  }
  .site-nav__brand img {
    height: 40px;
    width: auto;
    display: block;
  }

  /* Mobile: nav hides behind a drawer that drops from the header.
     Desktop (>= 900px): nav is inline in the bar, drawer styles vanish. */
  .site-nav__nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 260ms ease, opacity 200ms ease;
    pointer-events: none;
  }
  .site-nav__nav[data-open="true"] {
    max-height: 560px;
    opacity: 1;
    pointer-events: auto;
    box-shadow: 0 10px 30px rgba(27,27,36,0.06);
  }
  .site-nav__links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
    padding: var(--space-3) var(--space-4) var(--space-4);
    margin: 0;
  }
  .site-nav__links a {
    display: block;
    padding: 14px 16px;
    font-size: 17px;
    font-weight: 600;
    color: var(--color-ink-soft);
    text-decoration: none;
    border-radius: 12px;
    transition: background 140ms ease, color 140ms ease;
  }
  .site-nav__links a:hover,
  .site-nav__links a.is-active {
    background: color-mix(in srgb, var(--color-sunshine) 25%, transparent);
    color: var(--color-ink);
  }

  .site-nav__mobile-lang {
    padding-top: var(--space-3);
    margin-top: var(--space-2);
    border-top: 1px solid var(--color-line);
    padding-inline: 16px;
  }

  .site-nav__lang { display: none; }

  @media (min-width: 900px) {
    .site-nav__mobile-lang { display: none; }
    .site-nav__nav {
      position: static;
      max-height: none;
      overflow: visible;
      opacity: 1;
      pointer-events: auto;
      background: transparent;
      border: 0;
      box-shadow: none;
      transition: none;
    }
    .site-nav__links {
      flex-direction: row;
      align-items: center;
      gap: var(--space-4);
      padding: 0;
      flex-wrap: nowrap;
    }
    .site-nav__links a {
      position: relative;
      padding: 8px 4px;
      font-size: 15px;
      border-radius: 0;
      background: transparent;
      color: var(--color-ink-soft);
      white-space: nowrap;
    }
    .site-nav__links a::after {
      content: '';
      position: absolute;
      left: 4px;
      right: 4px;
      bottom: 2px;
      height: 2px;
      background: var(--color-coral);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 160ms ease;
      border-radius: 2px;
    }
    .site-nav__links a:hover {
      background: transparent;
      color: var(--color-coral);
    }
    .site-nav__links a:hover::after { transform: scaleX(1); }
    .site-nav__links a.is-active {
      background: transparent;
      color: var(--color-ink);
    }
    .site-nav__links a.is-active::after {
      transform: scaleX(1);
      background: var(--color-ink);
    }
    .site-nav__lang { display: inline-flex; }
    .site-nav__toggle { display: none !important; }
  }

  /* Hamburger — only visible below 900px, pinned to the left of the bar */
  .site-nav__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: 1.5px solid var(--color-line);
    border-radius: 12px;
    cursor: pointer;
    flex-shrink: 0;
    order: -1;
  }
  .site-nav__toggle-bar {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 200ms ease, opacity 200ms ease;
    transform-origin: center;
  }
  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>
